{% assign on_sale = false %}

{% if product.available and product.variants.first.compare_at_price > product.variants.first.price %}
{% assign on_sale = true %}
{% endif %}

{% comment %}Tính giá khuyến mãi{% endcomment %}
{% if product.variants.first.compare_at_price > product.variants.first.price %}
{% assign price_sale = 0 %} 
{% assign price_sale = product.variants.first.compare_at_price | minus: product.variants.first.price | divided_by:product.variants.first.compare_at_price | times : 100 | round : 0 %}
{% endif %}

{% assign sold_out = true %}
{% if product.available %}
{% assign sold_out = false %}
{% endif %}

{%- assign label_prefix_1 = settings.product_label_prefix_1 | default: 'label1_' -%}
{%- assign label_prefix_2 = settings.product_label_prefix_2 | default: 'label2_' -%}
{%- assign label1 = '' -%}
{%- assign label2 = '' -%}
{%- assign variant_in_detail = false -%}
{% comment %}Callers set the concise product_card_context contract.{% endcomment %}
{%- if product_card_context == 'product-tabs' or product_card_context == 'lookbook' or product_card_context == 'product-story' or product_card_context == 'header-mega' or product_card_context == 'collection' -%}
  {%- assign variant_in_detail = true -%}
{%- endif -%}
{%- for tag in product.tags -%}
{%- if tag contains label_prefix_1 -%}{%- assign label1 = tag | split: label_prefix_1 | last -%}{%- endif -%}
{%- if tag contains label_prefix_2 -%}{%- assign label2 = tag | split: label_prefix_2 | last -%}{%- endif -%}
{%- endfor -%}
<product-card class="product-card {{grid}}{% if variant_in_detail %} product-card--detail-variants{% endif %}{% if product_card_context == 'product-tabs' %} product-card--tabs{% elsif product_card_context == 'lookbook' %} product-card--lookbook{% elsif product_card_context == 'product-story' %} product-card--story{% elsif product_card_context == 'header-mega' %} product-card--header-mega{% elsif product_card_context == 'collection' %} product-card--collection{% endif %}">
  <div class="product-loop">
	<div class="product-inner">
		<div class="proloop--image">
			<a href="{{ product.url }}" class="ratio-image" title="{{ product.title | strip }}" aria-label="{{ product.title | strip }}">
				<img class="proloop--image-front lazyload" loading="lazy" decoding="async"
						 src="{% if product.images.size > 0 %}{{ product.featured_image.src | product_img_url: 'grande' }}{% elsif product_card_context == 'header-mega' and product_fallback_image != blank %}{{ product_fallback_image | asset_url }}{% else %}{{ 'no_image.jpg' | asset_url }}{% endif %}"
						 {% if product.images.size > 0 %}srcset="{{ product.featured_image.src | product_img_url: 'compact' }} 160w, {{ product.featured_image.src | product_img_url: 'grande' }} 600w, {{ product.featured_image.src | product_img_url: '1024x1024' }} 1024w" sizes="(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 50vw"{% endif %}
						 width="300" height="300" alt="{{product.title}}">
				{%- if product.images.size > 1 -%}
				<img class="proloop--image-back lazyload" loading="lazy" decoding="async"
						 src="{{ product.images[1].src | product_img_url: 'grande' }}"
						 srcset="{{ product.images[1].src | product_img_url: 'compact' }} 160w, {{ product.images[1].src | product_img_url: 'grande' }} 600w, {{ product.images[1].src | product_img_url: '1024x1024' }} 1024w"
						 sizes="(min-width: 1200px) 25vw, (min-width: 768px) 33vw, 50vw"
						 width="300" height="300" alt="" aria-hidden="true">
				{%- endif -%}
			</a>
			{%- if on_sale -%}<span class="pro--price-percent">-{{price_sale}}%</span>{%- endif -%}
			{% if settings.promotion_hrvapp_use and settings.promotion_hrvapp == 'appcombo' or settings.promotion_hrvapp == 'appbuyxgety' %}
			<div class="gift product_gift_label d-none" data-id="{{product.id}}">
				<img class="noreset lazyload" loading="lazy" decoding="async" src="{{ settings.combo_icon }}" width="30" height="30" alt="Icon quà tặng">
			</div>
			{% endif %}
			{%- if label1 != '' or label2 != '' or sold_out -%}
			<div class="pro--list-tags">
				{%- if label1 != '' -%}<span class="tag-item" style="--proloop-label-bg: {{settings.label1_bg_color}};--proloop-label-text: {{settings.label1_text_color}};">{{label1}}</span>{%- endif -%}
				{%- if label2 != '' -%}<span class="tag-item" style="--proloop-label-bg: {{settings.label2_bg_color}};--proloop-label-text: {{settings.label2_text_color}};">{{label2}}</span>{%- endif -%}
				{%- if sold_out -%}<span class="tag-item soldout">{{settings.product_soldout}}</span>{%- endif -%}
			</div>
			{%- endif -%}
			<div class="proloop--action">
				<add-to-cart data-variant-id="{{ product.variants.first.id }}" data-product-id="{{ product.id }}"
										 data-handle="{{ product.handle }}" data-quantity="1" data-mode="cart" data-state="idle"
										 {% if sold_out %}data-disabled="true"{% endif %}>
					<button type="button" class="btn-addtocart btn btn-secondary" button-effect data-role="trigger" aria-label="Thêm {{ product.title | strip }} vào giỏ" {% if sold_out %}disabled{% endif %}>
						<svg class="icon-svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
							<path fill-rule="evenodd" clip-rule="evenodd" d="M15.0528 8.5454C15.2318 8.5523 14.9717 8.55057 14.9379 8.55402C14.9717 8.54885 14.7758 8.56608 14.7302 8.57125C14.6052 8.58503 14.4701 8.60916 14.3485 8.63845C14.1847 8.67808 14.0395 8.72977 13.8689 8.73838C13.8233 8.7401 13.7659 8.73838 13.7118 8.73494C13.6814 8.73838 13.6527 8.74355 13.6223 8.74355C13.5801 8.74355 13.5379 8.73838 13.4957 8.73149L12.0652 10.7647C12.05 10.7871 12.0348 10.8112 12.0196 10.8353C11.9099 11.0352 11.7106 11.1575 11.4944 11.1575H5.65442C5.32848 11.1575 5.06164 10.8801 5.04307 10.532L5.61896 5.53701H9.28204C9.15875 5.47498 9.11484 4.13964 9.18915 4.00524H5.54803L5.05151 1.8463V1.84113C4.95356 1.43105 4.61241 1.1433 4.22229 1.14503H1.70593C1.31581 1.14675 1 1.48963 1 1.91177C1 2.33391 1.31581 2.67852 1.70593 2.67852H3.78657L4.27803 4.82023L3.63458 10.3994C3.6312 10.4304 3.62951 10.4631 3.62951 10.4941C3.62951 11.7071 4.53642 12.691 5.65442 12.691H11.4944C12.1902 12.691 12.837 12.3016 13.2069 11.6658L15.4446 8.4851C15.4125 8.48682 15.3804 8.49199 15.3466 8.49371C15.2538 8.5299 15.1558 8.55057 15.0528 8.5454Z" fill="currentColor"></path>
							<path fill-rule="evenodd" clip-rule="evenodd" d="M15.6906 8.02677C15.6906 8.02677 15.0708 8.63328 13.4934 8.73149L13.9156 9.16914L15.444 8.48337L15.7784 7.9613L15.6906 8.02677Z" fill="currentColor"></path>
							<path fill-rule="evenodd" clip-rule="evenodd" d="M9.152 4.00697H9.45261C9.45261 4.00697 9.30906 4.64793 9.45261 5.53356L9.18409 5.53873L8.47984 4.77199L9.152 4.00524V4.00697Z" fill="currentColor"></path>
							<path fill-rule="evenodd" clip-rule="evenodd" d="M6.40428 15.2789C6.40259 16.2318 5.64599 17.0002 4.71376 17.0002C3.78152 17.0002 3.02661 16.2266 3.02661 15.2755C3.02661 14.3244 3.78321 13.5542 4.71544 13.5542C5.16299 13.5542 5.59195 13.7368 5.90945 14.0608C6.22526 14.3847 6.40428 14.8241 6.40259 15.2807L6.40428 15.2789ZM4.4351 15.2755C4.4351 15.1187 4.56007 14.9895 4.71376 14.9895C4.78806 14.9895 4.86068 15.0205 4.91304 15.0739C4.96539 15.1273 4.9941 15.2014 4.9941 15.2772C4.9941 15.434 4.86744 15.5615 4.71376 15.5615C4.56007 15.5615 4.43341 15.4323 4.4351 15.2755Z" fill="currentColor"></path>
							<path fill-rule="evenodd" clip-rule="evenodd" d="M11.6396 15.2787C11.6396 14.8221 11.4623 14.3827 11.1448 14.0588C10.829 13.7349 10.3983 13.554 9.9508 13.5522C9.01856 13.5522 8.26196 14.3224 8.26196 15.2735C8.26196 16.2247 9.01687 16.9966 9.94911 16.9983C10.8813 16.9983 11.6379 16.2298 11.6396 15.2787ZM9.9508 14.991C9.79711 14.991 9.67045 15.1202 9.67045 15.277C9.67045 15.4338 9.79542 15.563 9.9508 15.563C10.1062 15.563 10.2311 15.4355 10.2311 15.2787C10.2311 15.2029 10.2007 15.1288 10.1484 15.0754C10.096 15.022 10.0234 14.991 9.94911 14.991H9.9508Z" fill="currentColor"></path>
							<path fill-rule="evenodd" clip-rule="evenodd" d="M13.4534 1C15.4125 1 17 2.61964 17 4.61834C17 6.61705 15.4125 8.23669 13.4534 8.23669C11.4944 8.23669 9.90686 6.61705 9.90686 4.61834C9.90686 2.61964 11.4944 1 13.4534 1ZM15.3213 4.25134V4.98535C15.3213 5.13525 15.2014 5.25759 15.0544 5.25759H14.08V6.25177C14.08 6.40167 13.9601 6.52401 13.8131 6.52401H13.0937C12.9468 6.52401 12.8285 6.40167 12.8269 6.25177V5.25759H11.8507C11.7038 5.25759 11.5856 5.13525 11.5839 4.98535V4.25134C11.5839 4.10144 11.7038 3.98083 11.8507 3.9791H12.8269V2.9832C12.8269 2.83329 12.9468 2.71268 13.0937 2.71096H13.8131C13.9601 2.71096 14.08 2.83329 14.08 2.9832V3.9791H15.0544C15.2014 3.9791 15.3213 4.10144 15.3213 4.25134Z" fill="currentColor"></path>
						</svg>
						<span data-btn-effect-span aria-hidden="true"></span>
					</button>
				</add-to-cart>
			</div>
			<div class="proloop--quickview">
				<button type="button" class="js-open-quickview btn-quickview btn btn-secondary" button-effect data-action="quickview" data-product-handle="{{ product.handle }}" aria-controls="fox-quick-view-modal" aria-haspopup="dialog" aria-label="Xem nhanh {{ product.title | strip }}">
					<svg class="icon-svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
						<path d="M9.00007 11.1004C9.99421 11.1004 10.8001 10.1602 10.8001 9.00039C10.8001 7.84056 9.99421 6.90039 9.00007 6.90039C8.00593 6.90039 7.20007 7.84056 7.20007 9.00039C7.20007 10.1602 8.00593 11.1004 9.00007 11.1004Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
						<path d="M17.1 9.0002C15.4003 12.1407 12.3465 15.3002 9.00002 15.3002C5.65355 15.3002 2.59973 12.1407 0.900024 9.0002C2.96872 6.01636 5.39249 2.7002 9.00002 2.7002C12.6076 2.7002 15.0314 6.01631 17.1 9.0002Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
					<span data-btn-effect-span aria-hidden="true"></span>
				</button>
			</div>
			{%- if product.available and product.variants.size > 1 and variant_in_detail == false -%}
			<div class="proloop--variant">
				{%- include 'product-swatch' -%}
			</div>
			{%- endif -%}
		</div>
		<div class="proloop--detail">
			{%- if settings.product_show_type and product.type != '' -%}
			<p class="pro--type">{{ product.type }}</p>
			{%- endif -%}
			<h3 class="pro--title">
				<a href="{{ product.url }}" title="{{ product.title | strip }}">{{ product.title }}</a>
			</h3>
			<div class="block-proloop-price {%if price_sale%}highlight{%endif%}">
				<span class="pro--price">
					{%- if product.variants[0].price == 0 or settings.disable_shop_buying-%}
					<a href="{{settings.product_contact_url}}">{{settings.product_contact_title}}</a>
					{%- else -%}
					{{product.variants[0].price | money}}
					{%- endif -%}
				</span>
				{%- if on_sale -%}<span class="pro--price-original"><del>{{product.variants[0].compare_at_price | money}}</del></span>{%- endif -%}
			</div>
			{%- if product.available and product.variants.size > 1 and variant_in_detail -%}
			<div class="proloop--variant proloop--variant-detail">
				{%- include 'product-swatch' -%}
			</div>
			{%- endif -%}
		</div>
	</div>
</div>
</product-card>
