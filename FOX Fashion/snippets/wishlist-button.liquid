{%- comment -%}
  Wishlist heart (behavior: <wishlist-button> in assets/wishlist.js, saved in localStorage).
  Input: wishlist_handle, wishlist_product_id, wishlist_title, wishlist_style ('card' = product card action, 'inline' = product page price row).
  State is read on connect, so hearts inside AJAX-loaded cards (quick view, lookbook, recently viewed) stay correct.
{%- endcomment -%}
{%- assign wishlist_style = wishlist_style | default: 'card' -%}
{%- capture wishlist_label_add -%}Thêm {{ wishlist_title | strip }} vào yêu thích{%- endcapture -%}
{%- capture wishlist_label_remove -%}Xóa {{ wishlist_title | strip }} khỏi yêu thích{%- endcapture -%}
<wishlist-button class="fox-wishlist-btn fox-wishlist-btn--{{ wishlist_style }}" data-handle="{{ wishlist_handle | escape }}" data-product-id="{{ wishlist_product_id }}" data-state="idle">
  <button
    type="button"
    class="{% if wishlist_style == 'card' %}btn-wishlist btn btn-secondary{% else %}fox-wishlist-btn__trigger{% endif %}"
    {% if wishlist_style == 'card' %}button-effect{% endif %}
    data-role="trigger"
    aria-pressed="false"
    aria-label="{{ wishlist_label_add | escape }}"
    data-label-add="{{ wishlist_label_add | escape }}"
    data-label-remove="{{ wishlist_label_remove | escape }}">
    <svg class="icon-svg fox-wishlist-btn__icon fox-wishlist-btn__icon--off" aria-hidden="true" focusable="false"><use xlink:href="#ic-fox-heart"></use></svg>
    <svg class="icon-svg fox-wishlist-btn__icon fox-wishlist-btn__icon--on" aria-hidden="true" focusable="false"><use xlink:href="#ic-fox-heart-filled"></use></svg>
    {%- if wishlist_style == 'card' -%}<span data-btn-effect-span aria-hidden="true"></span>{%- endif -%}
  </button>
</wishlist-button>
