<section class="fox-customer__form-panel" data-customer-panel="login" aria-labelledby="fox-customer-title">
  <h2 id="fox-customer-title">Đăng nhập</h2>
  <p class="fox-customer__subtitle">Chào mừng bạn trở lại.</p>

  {% if settings.header_account_use_otp_template %}
    <div class="fox-customer__method" role="group" aria-label="Đăng nhập">
      <button type="button" class="is-active" data-customer-method="standard">Đăng nhập bằng email</button>
      <button type="button" data-customer-method="phone">Đăng nhập bằng số điện thoại</button>
    </div>
  {% endif %}

  <div data-customer-standard-login>
    {% form 'customer_login' %}
      {{ form.errors | default_errors }}
      <div class="fox-floating-field fox-customer__field">
        <input id="fox-customer-email" type="{% if settings.header_account_use_otp_template %}text{% else %}email{% endif %}" name="customer[email]" autocomplete="email" inputmode="email" placeholder=" " required>
        <label for="fox-customer-email">Email{% if settings.header_account_use_otp_template %} / Số điện thoại{% endif %}</label>
      </div>
      {% if form.password_needed %}
        <div class="fox-floating-field fox-customer__field">
          <input id="fox-customer-password" type="password" name="customer[password]" autocomplete="current-password" placeholder=" " required>
          <label for="fox-customer-password">Mật khẩu</label>
          <button type="button" class="fox-customer__password-toggle" data-password-toggle="fox-customer-password" data-label-show="Hiện mật khẩu" data-label-hide="Ẩn mật khẩu" aria-label="Hiện mật khẩu">
            <svg class="customer-field__icon icon-eye-show" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use xlink:href="#ic-eye-show"></use></svg>
          </button>
        </div>
      {% endif %}
      <div class="fox-customer__meta">
        <button type="button" class="fox-customer__link" data-customer-recover>Quên mật khẩu</button>
      </div>
      <button class="btn btn-primary fox-hcs__btn btn-effect--out fox-customer__submit" button-effect type="submit">
        <span class="btn__label">Đăng nhập</span><span data-btn-effect-span aria-hidden="true"></span>
      </button>
    {% endform %}
  </div>

  {% if settings.header_account_use_otp_template %}
    <script async src="/phone_auth/lib.js"></script>
    <div class="fox-customer__otp" data-customer-otp-panel hidden>
      <form id="phone_auth_recaptcha" data-customer-phone-form>
        <input type="hidden" name="country_code" value="84">
        <div class="fox-floating-field fox-customer__field">
          <input id="fox-customer-phone" type="tel" name="phone_number" inputmode="tel" placeholder=" " pattern="[0-9]{10,12}" required>
          <label for="fox-customer-phone">Nhập số điện thoại</label>
        </div>
        <button class="btn btn-primary fox-hcs__btn btn-effect--out fox-customer__submit" button-effect id="phone-auth-submit" type="submit"><span class="btn__label">Gửi mã xác nhận</span><span data-btn-effect-span aria-hidden="true"></span></button>
      </form>
      <form action="/phone_auth/validate" method="post" data-customer-otp-form hidden>
        <input type="hidden" name="session_info">
        <div class="fox-floating-field fox-customer__field">
          <input id="fox-customer-otp" type="text" name="otp_code" inputmode="numeric" placeholder=" " required>
          <label for="fox-customer-otp">Nhập mã OTP</label>
        </div>
        <button class="btn btn-primary fox-hcs__btn btn-effect--out fox-customer__submit" button-effect type="submit"><span class="btn__label">Xác thực mã OTP</span><span data-btn-effect-span aria-hidden="true"></span></button>
      </form>
    </div>
  {% endif %}

  {%- if settings.customer_auth_social_login -%}
  <div class="fox-customer__social">
    <p class="fox-customer__divider"><span>Tiếp tục với</span></p>
    <div>
      <button type="button"><svg class="icon-svg" aria-hidden="true" focusable="false"><use xlink:href="#ic-google"></use></svg><span>Google</span></button>
      <button type="button"><svg class="icon-svg fox-customer__social-facebook" aria-hidden="true" focusable="false"><use xlink:href="#ic-facebook"></use></svg><span>Facebook</span></button>
    </div>
  </div>
  {%- endif -%}
  <p class="fox-customer__footer">Bạn chưa có tài khoản? <a href="/account/register">Đăng ký ngay</a></p>
</section>

<section class="fox-customer__form-panel" data-customer-panel="recover" hidden aria-labelledby="fox-customer-recover-title">
  <h2 id="fox-customer-recover-title">Khôi phục mật khẩu</h2>
  <p class="fox-customer__subtitle">Mật khẩu mới sẽ được gửi về email của bạn.</p>
  {% form 'recover_customer_password' %}
    {{ form.errors | default_errors }}
    <div class="fox-floating-field fox-customer__field">
      <input id="fox-customer-recover-email" type="email" name="email" autocomplete="email" placeholder=" " required>
      <label for="fox-customer-recover-email">Email</label>
    </div>
    <button class="btn btn-primary fox-hcs__btn btn-effect--out fox-customer__submit" button-effect type="submit"><span class="btn__label">Gửi email</span><span data-btn-effect-span aria-hidden="true"></span></button>
  {% endform %}
  <button type="button" class="fox-customer__back-link" data-customer-login>Trở về đăng nhập</button>
</section>
