{% assign drill_links = linklists[menuHandle].links %}
{% comment %}Concise shared state drives panels; JavaScript only manages navigation.{% endcomment %}

<div class="fox-mobile-drilldown" data-role="drilldown" data-root-panel="fox-mobile-panel-root">
  <section class="fox-mobile-drilldown__panel" id="fox-mobile-panel-root" data-panel-id="fox-mobile-panel-root" data-level="0" data-state="active" aria-hidden="false">
    <ul class="fox-mobile-drilldown__list" role="list">
      {% for link in drill_links %}
        {% include 'component-header-menu-shared' with operation: 'menu-state', menu_link: link %}
        {% assign has_panel = menu_has_panel %}
        <li class="fox-mobile-drilldown__item" style="--fox-drill-index: {{ forloop.index0 }}">
          <a class="fox-mobile-drilldown__link" href="{{ link.url }}">{{ link.title }}</a>
          {% if has_panel %}
            <button type="button" class="fox-mobile-drilldown__opener" data-action="open-panel" data-target-panel="fox-mobile-panel-{{ forloop.index }}" aria-controls="fox-mobile-panel-{{ forloop.index }}" aria-expanded="false" aria-label="Mở menu {{ link.title | strip | escape }}">
              <svg class="icon-svg" aria-hidden="true"><use xlink:href="#ic-arrow-right"></use></svg>
            </button>
          {% endif %}
        </li>
      {% else %}
        <li class="fox-mobile-drilldown__empty">Menu chưa có nội dung.</li>
      {% endfor %}
    </ul>
  </section>

  {% for link in drill_links %}
    {% assign lv1_index = forloop.index %}
    {% include 'component-header-menu-shared' with operation: 'menu-state', menu_link: link %}
    {% assign lv2_links = menu_children %}
    {% assign is_mega_1 = menu_is_mega_1 %}
    {% assign is_mega_2 = menu_is_mega_2 %}
    {% if menu_has_panel %}
      <section class="fox-mobile-drilldown__panel" id="fox-mobile-panel-{{ lv1_index }}" data-panel-id="fox-mobile-panel-{{ lv1_index }}" data-parent-panel="fox-mobile-panel-root" data-title="{{ link.title | strip | escape }}" data-level="1" data-state="hidden" aria-hidden="true" inert>
        {% if is_mega_1 %}
          <div class="fox-mobile-drilldown__mega fox-mobile-drilldown__mega--type-1">
            <div class="fox-mobile-drilldown__categories">
              {% for i in (1..4) %}
                {% include 'component-header-menu-shared' with operation: 'category-keys', mega_type: 1, item_index: i %}
                {% if settings[category_show_key] %}
                  <a class="fox-mobile-drilldown__category" href="{{ settings[category_url_key] | default: '/collections/all' }}" style="--fox-drill-index: {{ forloop.index0 }}">
                    <img src="{{ category_image_key | asset_url }}" width="64" height="64" loading="lazy" decoding="async" alt="{{ settings[category_alt_key] | default: settings[category_title_key] | escape }}">
                    <span>{{ settings[category_title_key] }}</span>
                  </a>
                {% endif %}
              {% endfor %}
            </div>

            <ul class="fox-mobile-drilldown__list fox-mobile-drilldown__link-group-list" role="list" aria-label="Nhóm liên kết">
              {% for i in (1..2) %}
                {% include 'component-header-menu-shared' with operation: 'link-group-state', item_index: i %}
                {% if link_group_visible %}
                    <li class="fox-mobile-drilldown__item" style="--fox-drill-index: {{ forloop.index0 }}">
                      <span class="fox-mobile-drilldown__link">{{ settings[link_group_title_key] }}</span>
                      <button type="button" class="fox-mobile-drilldown__opener" data-action="open-panel" data-target-panel="fox-mobile-panel-{{ lv1_index }}-mega-links-{{ i }}" aria-controls="fox-mobile-panel-{{ lv1_index }}-mega-links-{{ i }}" aria-expanded="false" aria-label="Mở menu {{ settings[link_group_title_key] | strip | escape }}"><svg class="icon-svg" aria-hidden="true"><use xlink:href="#ic-arrow-right"></use></svg></button>
                    </li>
                {% endif %}
              {% endfor %}
            </ul>

            {% comment %}The product slider stays last in the mega panel to preserve menu-first navigation.{% endcomment %}
            {% assign drill_collection = collections[settings.header_mega_1_collection] %}
            {% if settings.header_mega_1_collection_show and drill_collection != empty %}
              <section class="fox-mobile-drilldown__products" aria-label="{{ settings.header_mega_1_collection_title | escape }}">
                <slider-component data-preset="product" data-state="idle" data-loop="false" data-navigation="true" data-pagination="false" data-slides-mobile="1" data-slides-tablet="1" data-slides-desktop="1" data-space-mobile="12" data-space-tablet="12" data-space-desktop="12">
                  <div class="fox-mobile-drilldown__section-heading">
                    <h3>{{ settings.header_mega_1_collection_title }}</h3>
                    <div class="fox-mobile-drilldown__navigation" data-role="navigation">{% include 'swiper-navigation' with style: '01', previous_first: true %}</div>
                  </div>
                  <div class="swiper" data-role="viewport"><div class="swiper-wrapper">
                    {% for product in drill_collection.products limit: settings.header_mega_1_product_limit %}
                      <div class="swiper-slide">
                        <article class="fox-mobile-drilldown__product-card">
                          <a class="fox-mobile-drilldown__product-image" href="{{ product.url }}" aria-label="{{ product.title | strip | escape }}"><img src="{% if product.images.size > 0 %}{{ product.featured_image | product_img_url: 'master' }}{% else %}{{ 'no_image.jpg' | asset_url }}{% endif %}" width="180" height="180" loading="lazy" decoding="async" alt="{{ product.title | strip | escape }}"></a>
                          <div class="fox-mobile-drilldown__product-detail">
                            <h4><a href="{{ product.url }}">{{ product.title | escape }}</a></h4>
                            <div class="fox-mobile-drilldown__product-price">{% if product.variants[0].price > 0 %}{{ product.variants[0].price | money }}{% else %}{{ settings.product_contact_title }}{% endif %}{% if product.variants[0].compare_at_price > product.variants[0].price %}<del>{{ product.variants[0].compare_at_price | money }}</del>{% endif %}</div>
                            <a class="fox-mobile-drilldown__product-cta" href="{{ product.url }}" aria-label="Xem {{ product.title | strip | escape }}">Xem sản phẩm</a>
                          </div>
                        </article>
                      </div>
                    {% endfor %}
                  </div></div>
                </slider-component>
              </section>
            {% endif %}
          </div>
        {% elsif is_mega_2 %}
          <div class="fox-mobile-drilldown__mega fox-mobile-drilldown__mega--type-2">
            {% assign drill_category_count = 0 %}
            {% for i in (1..8) %}
              {% include 'component-header-menu-shared' with operation: 'category-keys', mega_type: 2, item_index: i %}
              {% if settings[category_show_key] %}{% assign drill_category_count = drill_category_count | plus: 1 %}{% endif %}
            {% endfor %}
            {% assign drill_demo_categories = false %}
            {% if drill_category_count == 0 %}{% assign drill_demo_categories = true %}{% endif %}
            <div class="fox-mobile-drilldown__category-grid">
              {% for i in (1..8) %}
                {% include 'component-header-menu-shared' with operation: 'category-keys', mega_type: 2, item_index: i %}
                {% assign category_show = settings[category_show_key] %}
                {% if drill_demo_categories %}{% assign category_show = true %}{% endif %}
                {% if category_show %}
                  <a class="fox-mobile-drilldown__category-card" href="{{ settings[category_url_key] | default: '/collections/all' }}" style="--fox-drill-index: {{ forloop.index0 }}">
                    <img src="{{ category_image_key | asset_url }}" width="160" height="160" loading="lazy" decoding="async" alt="{{ settings[category_alt_key] | default: settings[category_title_key] | escape }}">
                    <span>{{ settings[category_title_key] | default: 'Danh mục sản phẩm' }}</span>
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% else %}
          <ul class="fox-mobile-drilldown__list" role="list">
            {% for lv2 in lv2_links %}
              {% assign lv3_links = linklists[lv2.handle].links %}
              <li class="fox-mobile-drilldown__item" style="--fox-drill-index: {{ forloop.index0 }}">
                <a class="fox-mobile-drilldown__link" href="{{ lv2.url }}">{{ lv2.title }}</a>
                {% if lv3_links != empty %}
                  <button type="button" class="fox-mobile-drilldown__opener" data-action="open-panel" data-target-panel="fox-mobile-panel-{{ lv1_index }}-{{ forloop.index }}" aria-controls="fox-mobile-panel-{{ lv1_index }}-{{ forloop.index }}" aria-expanded="false" aria-label="Mở menu {{ lv2.title | strip | escape }}"><svg class="icon-svg" aria-hidden="true"><use xlink:href="#ic-arrow-right"></use></svg></button>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>
      {% if is_mega_1 %}
        {% for i in (1..2) %}
          {% include 'component-header-menu-shared' with operation: 'link-group-state', item_index: i %}
          {% if link_group_visible %}
            <section class="fox-mobile-drilldown__panel" id="fox-mobile-panel-{{ lv1_index }}-mega-links-{{ i }}" data-panel-id="fox-mobile-panel-{{ lv1_index }}-mega-links-{{ i }}" data-parent-panel="fox-mobile-panel-{{ lv1_index }}" data-title="{{ settings[link_group_title_key] | strip | escape }}" data-level="2" data-state="hidden" aria-hidden="true" inert>
              <ul class="fox-mobile-drilldown__list" role="list">
                {% for child_link in link_group_links %}<li class="fox-mobile-drilldown__item" style="--fox-drill-index: {{ forloop.index0 }}"><a class="fox-mobile-drilldown__link" href="{{ child_link.url | escape }}">{{ child_link.title | escape }}</a></li>{% endfor %}
              </ul>
            </section>
          {% endif %}
        {% endfor %}
      {% endif %}

      {% comment %}Capture every regular descendant panel while its level-1 context is active.{% endcomment %}
    {% for lv2 in lv2_links %}
      {% assign lv2_index = forloop.index %}
      {% assign lv3_links = linklists[lv2.handle].links %}
      {% if lv3_links != empty %}
        <section class="fox-mobile-drilldown__panel" id="fox-mobile-panel-{{ lv1_index }}-{{ lv2_index }}" data-panel-id="fox-mobile-panel-{{ lv1_index }}-{{ lv2_index }}" data-parent-panel="fox-mobile-panel-{{ lv1_index }}" data-title="{{ lv2.title | strip | escape }}" data-level="2" data-state="hidden" aria-hidden="true" inert>
          <ul class="fox-mobile-drilldown__list" role="list">
            {% for lv3 in lv3_links %}
              {% assign lv4_links = linklists[lv3.handle].links %}
              <li class="fox-mobile-drilldown__item" style="--fox-drill-index: {{ forloop.index0 }}">
                <a class="fox-mobile-drilldown__link" href="{{ lv3.url }}">{{ lv3.title }}</a>
                {% if lv4_links != empty %}<button type="button" class="fox-mobile-drilldown__opener" data-action="open-panel" data-target-panel="fox-mobile-panel-{{ lv1_index }}-{{ lv2_index }}-{{ forloop.index }}" aria-controls="fox-mobile-panel-{{ lv1_index }}-{{ lv2_index }}-{{ forloop.index }}" aria-expanded="false" aria-label="Mở menu {{ lv3.title | strip | escape }}"><svg class="icon-svg" aria-hidden="true"><use xlink:href="#ic-arrow-right"></use></svg></button>{% endif %}
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
      {% for lv3 in lv3_links %}
        {% assign lv3_index = forloop.index %}
        {% assign lv4_links = linklists[lv3.handle].links %}
        {% if lv4_links != empty %}
          <section class="fox-mobile-drilldown__panel" id="fox-mobile-panel-{{ lv1_index }}-{{ lv2_index }}-{{ lv3_index }}" data-panel-id="fox-mobile-panel-{{ lv1_index }}-{{ lv2_index }}-{{ lv3_index }}" data-parent-panel="fox-mobile-panel-{{ lv1_index }}-{{ lv2_index }}" data-title="{{ lv3.title | strip | escape }}" data-level="3" data-state="hidden" aria-hidden="true" inert>
            <ul class="fox-mobile-drilldown__list" role="list">
              {% for lv4 in lv4_links %}<li class="fox-mobile-drilldown__item" style="--fox-drill-index: {{ forloop.index0 }}"><a class="fox-mobile-drilldown__link" href="{{ lv4.url }}">{{ lv4.title }}</a></li>{% endfor %}
            </ul>
          </section>
        {% endif %}
      {% endfor %}
    {% endfor %}
    {% endif %}
  {% endfor %}
</div>
