{%- assign fox_topbar_show = true -%}
{%- if settings.use_topbar == false -%}{%- assign fox_topbar_show = false -%}{%- endif -%}
{%- if fox_topbar_show -%}
{%- assign fox_topbar_item_count = 0 -%}
{%- for i in (1..3) -%}
  {%- capture fox_topbar_show_key -%}useContent_topbar_{{ i }}{%- endcapture -%}
  {%- if settings[fox_topbar_show_key] != false -%}
    {%- assign fox_topbar_item_count = fox_topbar_item_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- capture schema_style_topbar -%}
  --topbar-bg: {{settings.topbar_bg | default: '#ffd600'}};
	--topbar-text: {{settings.topbar_text | default: '#ffffff'}};
  --topbar-hover: {{settings.topbar_text_hover | default: '#ffffff'}};
{%- endcapture -%}
<div class="block-topbar">
  <section class="topbar" style="{{schema_style_topbar-}}">
  	<div class="container">
  		<div class="wrapper">
			{% comment %}Announcements use the full topbar width.{% endcomment %}
			<slider-component
          class="topbar-content position-relative swiperStyle"
          data-preset="announcement"
          data-autoplay="true"
          data-autoplay-delay="4500"
          data-transition-duration="650"
          data-loop="true"
          data-pagination="false"
          data-navigation="{% if fox_topbar_item_count > 1 %}true{% else %}false{% endif %}"
          data-slides-mobile="1"
          data-slides-tablet="1"
          data-slides-desktop="1"
          data-space-mobile="10"
          data-space-tablet="10"
          data-space-desktop="10"
          data-state="idle">
				{%- if fox_topbar_item_count > 1 -%}
				<button
					type="button"
					class="swiper-nav swiper-button-prev"
					data-action="previous"
					aria-label="Thông báo trước">
					<svg class="icon-svg" style="transform:scaleX(-1);" aria-hidden="true"><use xlink:href="#ic-chevron-right"></use></svg>
				</button>
				{%- endif -%}
  				<div class="swiper swiper-container" data-role="viewport">
  					<div class="swiper-wrapper">
  						{%- for i in (1..3) -%}
  						{%-capture show-%}useContent_topbar_{{i}}{%-endcapture-%}
						{%-capture text-%}textContent_topbar_{{i}}{%-endcapture-%}
						{%-capture url-%}urlContent_topbar_{{i}}{%-endcapture-%}
						{%- assign fox_topbar_item_show = true -%}
						{%- if settings[show] == false -%}{%- assign fox_topbar_item_show = false -%}{%- endif -%}
						{%- if i == 1 -%}
						{%- assign fox_topbar_demo_text = 'Miễn phí vận chuyển cho đơn hàng từ 500.000₫' -%}
						{%- assign fox_topbar_demo_url = '/collections/all' -%}
						{%- elsif i == 2 -%}
						{%- assign fox_topbar_demo_text = 'Đổi trả dễ dàng trong 30 ngày' -%}
						{%- assign fox_topbar_demo_url = '/pages/about-us' -%}
						{%- else -%}
						{%- assign fox_topbar_demo_text = 'Ưu đãi dành riêng cho thành viên mới' -%}
						{%- assign fox_topbar_demo_url = '/account/register' -%}
						{%- endif -%}
						{%- if fox_topbar_item_show -%}
						<div class="swiper-slide">
							<div class="topbar-item">
								<a href="{{ settings[url] | default: fox_topbar_demo_url }}" title="{{ settings[text] | default: fox_topbar_demo_text | strip | escape }}">{{ settings[text] | default: fox_topbar_demo_text }}</a>
  							</div>
  						</div>
  						{%- endif -%}
  						{%- endfor -%}
  					</div>
  				</div>
				{%- if fox_topbar_item_count > 1 -%}
				<button type="button" class="swiper-nav swiper-button-next" data-action="next" aria-label="Thông báo tiếp theo">
					<svg class="icon-svg" aria-hidden="true"><use xlink:href="#ic-chevron-right"></use></svg>
				</button>
				{%- endif -%}
  			</slider-component>
		</div>
  	</div>
  </section>
</div>
{%- endif -%}
