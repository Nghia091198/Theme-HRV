{%- comment -%}
  One-line customer address: only the parts that are filled (street, ward, district, province), comma separated.
  Input: address_line_source (a customer address).
{%- endcomment -%}
{%- assign address_line_parts = '' -%}
{%- if address_line_source.address1 != blank -%}{%- assign address_line_parts = address_line_parts | append: address_line_source.address1 | append: '||' -%}{%- endif -%}
{%- if address_line_source.ward != blank -%}{%- assign address_line_parts = address_line_parts | append: address_line_source.ward | append: '||' -%}{%- endif -%}
{%- if address_line_source.district != blank -%}{%- assign address_line_parts = address_line_parts | append: address_line_source.district | append: '||' -%}{%- endif -%}
{%- if address_line_source.province != blank -%}{%- assign address_line_parts = address_line_parts | append: address_line_source.province | append: '||' -%}{%- endif -%}
{%- assign address_line_text = address_line_parts | split: '||' | join: ', ' | strip -%}
{%- if address_line_text != blank -%}
<p>{{ address_line_text | escape }}</p>
{%- else -%}
<p class="note">Chưa có địa chỉ</p>
{%- endif -%}
