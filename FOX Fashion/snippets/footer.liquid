{%- assign fox_footer_contact_phone = settings.footer_contact_phone -%}
{%- assign fox_footer_contact_email = settings.footer_contact_email -%}
{%- assign fox_footer_contact_visible = false -%}
{%- if settings.footer_contact_show -%}
  {%- if settings.footer_contact_title != blank or settings.footer_contact_address != blank or fox_footer_contact_phone != blank or fox_footer_contact_email != blank or settings.footer_contact_extra != blank -%}
    {%- assign fox_footer_contact_visible = true -%}
  {%- endif -%}
{%- endif -%}
{%- if settings.footer_show -%}
  <footer
    class="fox-footer"
    style="--fox-footer-bg: {{ settings.theme_color | default: '#1B2631' | escape }};">
    <div class="container-fluid">
      <div class="fox-footer__main{% if fox_footer_contact_visible %} fox-footer__main--with-contact{% endif %}">
        <div class="fox-footer__brand">
          <a class="fox-footer__logo-link" href="/" aria-label="Trang chủ - {{ shop.name | escape }}">
            {%- if settings.footer_logo_show -%}
              {%- include 'render-img' with src: "footer_logo.png", alt: alt_text, w: '300', h: '160', className: "img-fluid fox-footer__logo" -%}
            {%- else -%}
              <span class="fox-footer__logo-text">{{ shop.name | escape }}</span>
            {%- endif -%}
          </a>

          {%- if settings.footer_newsletter_show -%}
            <div class="fox-footer__newsletter">
              {%- if settings.footer_newsletter_title != blank -%}
                <h2 class="fox-footer__newsletter-title">{{ settings.footer_newsletter_title | escape }}</h2>
              {%- endif -%}
              {%- if settings.footer_newsletter_description != blank -%}
                <p class="fox-footer__newsletter-description">{{ settings.footer_newsletter_description | escape }}</p>
              {%- endif -%}

              {%- form 'customer' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="fox-footer__newsletter-field">
                  <label class="fox-footer__sr-only" for="FoxFooterEmail">Email</label>
                  <input
                    id="FoxFooterEmail"
                    class="fox-footer__newsletter-input"
                    type="email"
                    name="contact[email]"
                    value=""
                    placeholder="{{ settings.footer_newsletter_placeholder | default: 'Nhập email của bạn' | escape }}"
                    autocomplete="email" 
                    autocapitalize="off"
                    spellcheck="false"
                    required>
                  <button class="fox-footer__newsletter-button" type="submit">
                    <span>{{ settings.footer_newsletter_button_label | default: 'Đăng ký' | escape }}</span>
                    <svg aria-hidden="true" focusable="false">
                      <use xlink:href="#ic-arrow-45top-r"></use>
                    </svg>
                  </button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="fox-footer__form-message fox-footer__form-message--success" role="status">
                    Cảm ơn bạn đã đăng ký nhận tin.
                  </p>
                {%- elsif form.errors != blank -%}
                  <p class="fox-footer__form-message fox-footer__form-message--error" role="alert">
                    Không thể đăng ký. Vui lòng kiểm tra lại email.
                  </p>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}

          {% comment %}Capture prevents an empty social wrapper when every URL is blank.{% endcomment %}
          {%- capture fox_footer_socials -%}{%- include 'list-socials' with style:'social--basic',link_style:true -%}{%- endcapture -%}
          {%- assign fox_footer_socials = fox_footer_socials | strip -%}
          {%- if fox_footer_socials != blank -%}<div class="fox-footer__socials">{{ fox_footer_socials }}</div>{%- endif -%}
        </div>

        {%- if fox_footer_contact_visible -%}
          <div class="fox-footer__contact">
            {%- if settings.footer_contact_title != blank -%}
              <h2 class="fox-footer__contact-title">{{ settings.footer_contact_title | escape }}</h2>
            {%- endif -%}
            {%- if settings.footer_contact_address != blank or fox_footer_contact_phone != blank or fox_footer_contact_email != blank -%}
              <ul class="fox-footer__contact-list">
                {%- if settings.footer_contact_address != blank -%}
                  <li class="fox-footer__contact-item">
                    <svg aria-hidden="true" focusable="false"><use xlink:href="#ic-map"></use></svg>
                    <span>{{ settings.footer_contact_address | escape }}</span>
                  </li>
                {%- endif -%}
                {%- if fox_footer_contact_phone != blank -%}
                  <li class="fox-footer__contact-item">
                    <svg aria-hidden="true" focusable="false"><use xlink:href="#ic-phone"></use></svg>
                    <a rel="nofollow" href="tel:{{ fox_footer_contact_phone | remove: ' ' | remove: '.' | remove: '-' | escape }}">{{ fox_footer_contact_phone | escape }}</a>
                  </li>
                {%- endif -%}
                {%- if fox_footer_contact_email != blank -%}
                  <li class="fox-footer__contact-item">
                    <svg aria-hidden="true" focusable="false"><use xlink:href="#ic-mail"></use></svg>
                    <a rel="nofollow" href="mailto:{{ fox_footer_contact_email | strip | escape }}">{{ fox_footer_contact_email | escape }}</a>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}
            {%- if settings.footer_contact_extra != blank -%}
              <p class="fox-footer__contact-extra">{{ settings.footer_contact_extra | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if settings.footer_help_menu != blank and linklists[settings.footer_help_menu].links != blank -%}
          <fox-footer-menu class="fox-footer-menu" data-state="idle">
            <details class="fox-footer__menu-group">
              <summary class="fox-footer__menu-summary">
                <span>{{ settings.footer_help_title | default: 'Hỗ trợ' | escape }}</span>
                <span class="fox-footer__menu-toggle" aria-hidden="true">
                  <svg focusable="false"><use xlink:href="#ic-chevron"></use></svg>
                </span>
              </summary>
              <ul class="fox-footer__menu">
                {%- for link in linklists[settings.footer_help_menu].links -%}
                  <li><a class="fox-footer__menu-link fox-text-link" href="{{ link.url | escape }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </details>
          </fox-footer-menu>
        {%- endif -%}

        {%- if settings.footer_about_menu != blank and linklists[settings.footer_about_menu].links != blank -%}
          <fox-footer-menu class="fox-footer-menu" data-state="idle">
            <details class="fox-footer__menu-group">
              <summary class="fox-footer__menu-summary">
                <span>{{ settings.footer_about_title | default: 'Về FOX' | escape }}</span>
                <span class="fox-footer__menu-toggle" aria-hidden="true">
                  <svg focusable="false"><use xlink:href="#ic-chevron"></use></svg>
                </span>
              </summary>
              <ul class="fox-footer__menu">
                {%- for link in linklists[settings.footer_about_menu].links -%}
                  <li><a class="fox-footer__menu-link fox-text-link" href="{{ link.url | escape }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </details>
          </fox-footer-menu>
        {%- endif -%}
      </div>

      <div class="fox-footer__bottom">
        <p class="fox-footer__copyright">
          {%- if settings.footer_copyright != blank -%}
            {{ settings.footer_copyright | escape }}
          {%- else -%}
            Copyright &copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}
          {%- endif -%}
        </p>

        {%- if settings['footer_payment_image.png'] != blank -%}
          <img
            class="fox-footer__payment-image"
            src="{%- if settings['footer_payment_image.png'] contains '//' -%}{{ settings['footer_payment_image.png'] | escape }}{%- else -%}{{ settings['footer_payment_image.png'] | asset_url | escape }}{%- endif -%}"
            width="360"
            height="48"
            alt="{{ settings.footer_payment_alt | default: 'Các phương thức thanh toán được chấp nhận' | escape }}"
            loading="lazy"
            decoding="async">
        {%- endif -%}
      </div>
    </div>
  </footer>
{%- endif -%}
