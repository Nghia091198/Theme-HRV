{%- assign fox_account_banner_style = '' -%}
{%- if settings.customer_auth_banner_show -%}
  {%- capture fox_account_banner_style -%}--fox-account-banner-desktop: url('{{ 'customer_auth_banner_desktop.jpg' | asset_url }}'); --fox-account-banner-mobile: url('{{ 'customer_auth_banner_mobile.jpg' | asset_url }}'); {% endcapture -%}
{%- endif -%}
<section class="fox-account" data-account-shell style="{{ fox_account_banner_style }}--fox-account-overlay: {{ settings.customer_auth_overlay_opacity | default: 42 }}%;">
  <div class="fox-account__backdrop" aria-hidden="true"></div>
  <div class="container fox-account__stage">
    {%- include 'component-breadcrumb' with container: false, center: false, bgColor: 'transparent', textColor: '#fff' -%}
    <div class="fox-account__heading">
      <h1>{{ fox_account_title | escape }}</h1>
    </div>
    <div class="fox-account__layout">
      <div class="fox-account__side">
        <aside class="fox-account__sidebar">
          {% include 'sidebar-account' %}
        </aside>
        {{ fox_account_sidebar_extra }}
      </div>
      <div class="fox-account__content">{{ fox_account_content }}</div>
    </div>
  </div>
</section>
