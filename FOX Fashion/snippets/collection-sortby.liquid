<details class="fox-collection__sort" data-sort data-sort-value="manual">
    <summary>
        <span class="fox-collection__sort-caption">Sắp xếp theo</span>
        <span data-sort-label>Nổi bật</span>
        <span class="fox-collection__sort-chevron" aria-hidden="true"></span>
    </summary>
    <ul class="fox-collection__sort-options" data-role="sort-options" aria-label="Sắp xếp sản phẩm">
        <li>
            <a href="{{ fox_collection_url | escape }}" data-sort-option="manual" aria-current="true">Nổi bật</a>
        </li>
        <li>
            <a href="{{ fox_collection_url | escape }}?sort_by=created-descending" data-sort-option="created-descending">
            Mới nhất
            </a>
        </li>
        <li>
            <a href="{{ fox_collection_url | escape }}?sort_by=price-ascending" data-sort-option="price-ascending">
                Giá: thấp đến cao
            </a>
        </li>
        <li>
            <a href="{{ fox_collection_url | escape }}?sort_by=price-descending" data-sort-option="price-descending">
                Giá: cao đến thấp
            </a>
        </li>
    </ul>
</details>