{%- assign np_visible = false -%}
{%- if settings.newsletter_popup_show and template == 'index' -%}{%- assign np_visible = true -%}{%- endif -%}
{%- if np_visible -%}
{%- assign np_mode = settings.newsletter_popup_mode | default: 'form' -%}
<newsletter-popup
  class="fox-np fox-np--{{ np_mode }}"
  data-mode="{{ np_mode }}"
  data-delay="{{ settings.newsletter_popup_delay | default: 5 }}"
  data-days="{{ settings.newsletter_popup_days | default: 3 }}"
  data-state="idle">
  <modal-component id="fox-newsletter-popup" class="fox-np__modal" data-state="closed">
    <dialog data-role="dialog" class="fox-np__dialog" aria-labelledby="fox-np-title">
      {%- capture np_close -%}
      <button type="button" class="fox-quick-view__close fox-np__close" data-action="close" aria-label="Đóng">
        <svg class="fox-quick-view__close-progress" width="90" height="90" viewBox="0 0 90 90" fill="none" aria-hidden="true" focusable="false">
          <circle class="fox-quick-view__close-track" cx="45" cy="45" r="43.5"></circle>
          <circle class="fox-quick-view__close-value" cx="45" cy="45" r="43.5" pathLength="1"></circle>
        </svg>
        <svg class="fox-quick-view__close-icon" aria-hidden="true" focusable="false" width="10" height="10" viewBox="0 0 10 10" fill="none">
          <path fill="currentColor" d="M6.17839 5L9.75586 1.42253C10.0814 1.09701 10.0814 0.569661 9.75586 0.244141C9.43034 -0.0813802 8.90299 -0.0813802 8.57747 0.244141L5 3.82161L1.42253 0.244141C1.09701 -0.0813802 0.569661 -0.0813802 0.244141 0.244141C-0.0813802 0.569661 -0.0813802 1.09701 0.244141 1.42253L3.82161 5L0.244141 8.57747C-0.0813802 8.90299 -0.0813802 9.43034 0.244141 9.75586C0.406901 9.91862 0.620117 10 0.833333 10C1.04655 10 1.25977 9.91862 1.42253 9.75586L5 6.17839L8.57747 9.75586C8.74023 9.91862 8.95345 10 9.16667 10C9.37988 10 9.5931 9.91862 9.75586 9.75586C10.0814 9.43034 10.0814 8.90299 9.75586 8.57747L6.17839 5Z"></path>
        </svg>
      </button>
      {%- endcapture -%}

      {%- if np_mode == 'banner' -%}
      <div class="fox-np__banner">
        {{ np_close }}
        <h2 id="fox-np-title" class="fox-np__sr">{{ settings.newsletter_popup_banner_alt | default: shop.name | escape }}</h2>
        <a class="fox-np__banner-link" href="{{ settings.newsletter_popup_banner_url | default: '/collections/all' | escape }}" data-np-banner>
          {%- include 'render-img' with src: 'newsletter_popup_banner.jpg', src_mobile: 'newsletter_popup_banner_mobile.jpg', class: 'fox-np__banner-img', alt: settings.newsletter_popup_banner_alt, w: '1200', h: '800', w_mobile: '720', h_mobile: '960', sizes: '(min-width: 768px) 760px, 92vw', loading: 'lazy' -%}
        </a>
      </div>
      {%- else -%}
      <div class="fox-np__panel">
        <div class="fox-np__media">
          {%- include 'render-img' with src: 'newsletter_popup_form_image.jpg', class: 'fox-np__media-img', decorative: true, w: '800', h: '1000', sizes: '(min-width: 768px) 400px, 100vw', loading: 'lazy' -%}
          {%- if settings.newsletter_popup_badge != blank -%}<span class="fox-np__badge">{{ settings.newsletter_popup_badge | escape }}</span>{%- endif -%}
        </div>
        <div class="fox-np__body">
          {{ np_close }}
          <div class="fox-np__view" data-np-view="form">
            {%- if settings.newsletter_popup_eyebrow != blank -%}<p class="fox-np__eyebrow">{{ settings.newsletter_popup_eyebrow | escape }}</p>{%- endif -%}
            <h2 id="fox-np-title" class="fox-np__title">{{ settings.newsletter_popup_title | default: 'Đăng ký nhận tin' | escape }}</h2>
            {%- if settings.newsletter_popup_desc != blank -%}<p class="fox-np__desc">{{ settings.newsletter_popup_desc | escape }}</p>{%- endif -%}
            {%- form 'customer', class: 'fox-np__form' -%}
              <input type="hidden" name="contact[tags]" value="Đăng ký nhận bản tin, Popup nhận tin">
              {%- if form.posted_successfully? -%}<span data-np-posted hidden></span>{%- endif -%}
              <div class="fox-np__field">
                <label class="fox-np__sr" for="FoxNewsletterPopupEmail">Email</label>
                <input id="FoxNewsletterPopupEmail" class="fox-np__input" type="email" name="contact[email]" placeholder="{{ settings.newsletter_popup_placeholder | default: 'Email của bạn…' | escape }}" autocomplete="email" autocapitalize="off" spellcheck="false" required>
                <button class="btn btn-secondary btn-effect--out fox-np__submit" type="submit" button-effect data-np-submit>
                  <span class="btn__label" data-np-submit-label>{{ settings.newsletter_popup_button | default: 'Nhận mã' | escape }}</span>
                  <span data-btn-effect-span aria-hidden="true"></span>
                </button>
              </div>
              <p class="fox-np__error" data-np-error role="alert" hidden>Không thể đăng ký. Vui lòng kiểm tra lại email.</p>
            {%- endform -%}
          </div>

          <div class="fox-np__view fox-np__view--success" data-np-view="success" hidden>
            <span class="fox-np__success-mark" aria-hidden="true"></span>
            <h2 class="fox-np__title" tabindex="-1" data-np-success-title>{{ settings.newsletter_popup_success_title | default: 'Cảm ơn bạn đã đăng ký!' | escape }}</h2>
            {%- if settings.newsletter_popup_success_desc != blank -%}<p class="fox-np__desc">{{ settings.newsletter_popup_success_desc | escape }}</p>{%- endif -%}
            <button type="button" class="btn btn-secondary btn-effect--out fox-np__done" button-effect data-action="close">
              <span class="btn__label">Mua sắm ngay</span>
              <span data-btn-effect-span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </div>
      {%- endif -%}
    </dialog>
  </modal-component>
</newsletter-popup>
{%- endif -%}
