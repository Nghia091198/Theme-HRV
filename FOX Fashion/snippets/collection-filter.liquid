{%- assign filter_limit = 10 -%}
<aside class="core-offcanvas__panel fox-collection__filters" data-role="filters" aria-label="Bộ lọc sản phẩm">
  <div class="core-offcanvas__content fox-collection__filters-content">
  <div class="fox-collection__filters-heading">
    <span>Bộ lọc</span>
    <button type="button" class="fox-collection__filter-close" data-filter-close aria-label="Đóng bộ lọc">×</button>
  </div> 
 
  {%- if settings.use_available_filter -%}
    <label class="fox-collection__availability">
      <span>Còn hàng</span>
      <input type="checkbox" role="switch" data-filter data-filter-group="availability" data-filter-label="Còn hàng" data-filter-param-value="true" data-filter-value="(available:product=true)">
      <span class="fox-collection__availability-switch" aria-hidden="true"></span>
    </label>
  {%- endif -%}

  {%- if settings.use_type_filter -%}
  <details class="fox-collection__filter-group" open>
    <summary>{{settings.title_type_filter}}</summary>
    {%- assign fox_filter_option_count = 0 -%}
    <ul id="fox-collection-type-options-{{ collection.id | default: 0 }}" class="fox-collection__filter-options fox-scrollbar">
      {%- for fox_product_type in collection.all_types -%}
        {%- if fox_product_type != blank -%}
          {%- assign fox_filter_option_count = fox_filter_option_count | plus: 1 -%}
      <li{% if fox_filter_option_count > filter_limit %} data-filter-extra{% endif %}>
        <label class="fox-collection__filter-option">
          <input type="checkbox" data-filter data-filter-group="type" data-filter-label="{{ fox_product_type | escape }}" data-filter-param-value="{{ fox_product_type | escape }}" data-filter-value="(product_type:product**={{ fox_product_type | escape }})">
          <span>{{ fox_product_type | escape }}</span>
        </label>
      </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if fox_filter_option_count > filter_limit -%}
      <button type="button" class="fox-collection__filter-options-toggle" data-filter-options-toggle aria-controls="fox-collection-type-options-{{ collection.id | default: 0 }}" aria-expanded="true" hidden>Xem thêm</button>
    {%- endif -%}
  </details>
  {%- endif -%}

  {%- if settings.use_vendor_filter -%}
  <details class="fox-collection__filter-group" open>
    <summary>{{settings.title_vendor_filter}}</summary>
    {%- assign fox_filter_option_count = 0 -%}
    <ul id="fox-collection-vendor-options-{{ collection.id | default: 0 }}" class="fox-collection__filter-options fox-scrollbar">
      {%- for fox_vendor in collection.all_vendors -%}
        {%- if fox_vendor != blank -%}
          {%- assign fox_filter_option_count = fox_filter_option_count | plus: 1 -%}
      <li{% if fox_filter_option_count > filter_limit %} data-filter-extra{% endif %}>
        <label class="fox-collection__filter-option">
          <input type="checkbox" data-filter data-filter-group="vendor" data-filter-label="{{ fox_vendor | escape }}" data-filter-param-value="{{ fox_vendor | escape }}" data-filter-value="(vendor:product**={{ fox_vendor | escape }})">
          <span>{{ fox_vendor | escape }}</span>
        </label>
      </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if fox_filter_option_count > filter_limit -%}
      <button type="button" class="fox-collection__filter-options-toggle" data-filter-options-toggle aria-controls="fox-collection-vendor-options-{{ collection.id | default: 0 }}" aria-expanded="true" hidden>Xem thêm</button>
    {%- endif -%}
  </details>
  {%- endif -%}

  {%- if settings.use_price_filter -%}
  <details class="fox-collection__filter-group" open>
    <summary>{{ settings.title_price_filter | default: 'Khoảng giá' | escape }}</summary>
    <ul class="fox-collection__filter-options fox-scrollbar" role="radiogroup" aria-label="{{ settings.title_price_filter | default: 'Khoảng giá' | escape }}">
      {%- for fox_price_index in (1..5) -%}
        {%- capture fox_price_min_key -%}{{ fox_price_index }}_price_from{%- endcapture -%}
        {%- capture fox_price_max_key -%}{{ fox_price_index }}_price_to{%- endcapture -%}
        {%- assign fox_price_min = settings[fox_price_min_key] | plus: 0 -%}
        {%- assign fox_price_max = settings[fox_price_max_key] | plus: 0 -%}
        {%- assign fox_price_min_money = fox_price_min | times: 100 -%}
        {%- assign fox_price_max_money = fox_price_max | times: 100 -%}
        {%- if fox_price_index == 1 and fox_price_max > 0 -%}
      <li>
        <label class="fox-collection__filter-option">
          <input type="radio" name="fox-collection-price-{{ collection.id | default: 0 }}" data-filter data-filter-group="price" data-filter-label="Dưới {{ fox_price_max_money | money | escape }}" data-filter-param-value="0-{{ fox_price_max }}" data-filter-value="(price:product&lt;{{ fox_price_max }})">
          <span>Dưới {{ fox_price_max_money | money }}</span>
        </label>
      </li>
        {%- elsif fox_price_index == 5 and fox_price_min > 0 -%}
      <li>
        <label class="fox-collection__filter-option">
          <input type="radio" name="fox-collection-price-{{ collection.id | default: 0 }}" data-filter data-filter-group="price" data-filter-label="Trên {{ fox_price_min_money | money | escape }}" data-filter-param-value="{{ fox_price_min }}+" data-filter-value="(price:product&gt;{{ fox_price_min }})">
          <span>Trên {{ fox_price_min_money | money }}</span>
        </label>
      </li>
        {%- elsif fox_price_min > 0 and fox_price_max >= fox_price_min -%}
      <li>
        <label class="fox-collection__filter-option">
          <input type="radio" name="fox-collection-price-{{ collection.id | default: 0 }}" data-filter data-filter-group="price" data-filter-label="{{ fox_price_min_money | money | escape }} - {{ fox_price_max_money | money | escape }}" data-filter-param-value="{{ fox_price_min }}-{{ fox_price_max }}" data-filter-value="((price:product&gt;={{ fox_price_min }})&amp;&amp;(price:product&lt;={{ fox_price_max }}))">
          <span>{{ fox_price_min_money | money }} - {{ fox_price_max_money | money }}</span>
        </label>
      </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </details>
  {%- endif -%}

  {%- if settings.use_color_filter -%}
  <details class="fox-collection__filter-group" open>
    <summary>{{ settings.title_color_filter | default: 'Màu sắc' | escape }}</summary>
    {%- assign fox_filter_option_count = 0 -%}
    <ul id="fox-collection-color-options-{{ collection.id | default: 0 }}" class="fox-collection__filter-options fox-scrollbar fox-collection__filter-options--color">
      {%- for fox_color_index in (1..21) -%}
        {%- capture fox_color_show_key -%}use_color_filter_{{ fox_color_index }}{%- endcapture -%}
        {%- capture fox_color_name_key -%}name_color_filter_{{ fox_color_index }}{%- endcapture -%}
        {%- capture fox_color_code_key -%}code_color_filter_{{ fox_color_index }}{%- endcapture -%}
        {%- assign fox_color_name = settings[fox_color_name_key] | strip -%}
        {%- if settings[fox_color_show_key] and fox_color_name != blank -%}
          {%- assign fox_color_code = settings[fox_color_code_key] | default: '#000000' -%}
          {%- capture fox_color_tag -%}color:{{ fox_color_name }}{%- endcapture -%}
          {%- assign fox_filter_option_count = fox_filter_option_count | plus: 1 -%}
      <li>
        <label class="fox-collection__filter-option">
          <input type="checkbox" data-filter data-filter-group="color" data-filter-label="{{ fox_color_name | escape }}" data-filter-param-value="{{ fox_color_tag | escape }}" data-filter-value="(tag:product contains {{ fox_color_tag | escape }})">
          <span class="fox-collection__filter-swatch" style="--fox-filter-swatch: {{ fox_color_code | escape }};" aria-hidden="true"></span>
          <span>{{ fox_color_name | escape }}</span>
        </label>
      </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </details>
  {%- endif -%}
  
  {%- if settings.use_size_filter -%}
    <details class="fox-collection__filter-group" open>
      <summary>{{ settings.title_size_filter | default: 'Kích thước' | escape }}</summary>
      {%- assign fox_size_values = settings.values_size_filter | default: '' | split: ';' -%}
      <ul id="fox-collection-size-options-{{ collection.id | default: 0 }}" class="fox-collection__filter-options fox-scrollbar fox-collection__filter-options--size">
        {%- for size in fox_size_values -%} 
        <li>
          <label class="fox-collection__filter-option">
            <input type="checkbox" data-filter data-filter-group="size" data-filter-label="{{ fox_size | escape }}" data-filter-param-value="{{ fox_size | escape }}" data-filter-value="(variant:product contains {{ fox_size | escape }})">
            <span>{{ size }}</span>
          </label>
        </li>
        {%- endfor -%}
      </ul>
    </details>
    {%- endif -%}

  {%- if settings.use_metal_filter -%}
  <details class="fox-collection__filter-group" open>
    <summary>{{ settings.title_metal_filter | default: 'Chất liệu' | escape }}</summary>
    {%- assign fox_filter_option_count = 0 -%}
    <ul id="fox-collection-material-options-{{ collection.id | default: 0 }}" class="fox-collection__filter-options fox-scrollbar">
      {%- for tag in collection.all_tags -%}
        {%- if tag contains 'material:' -%}
          {%- assign fox_tag_label = tag | split: ':' | last | strip -%}
          {%- assign fox_filter_option_count = fox_filter_option_count | plus: 1 -%}
      <li{% if fox_filter_option_count > 5 %} data-filter-extra{% endif %}>
        <label class="fox-collection__filter-option">
          <input type="checkbox" data-filter data-filter-group="material" data-filter-label="{{ fox_tag_label | escape }}" data-filter-param-value="{{ tag | escape }}" data-filter-value="(tag:product contains {{ tag | escape }})">
          <span>{{ fox_tag_label | escape }}</span>
        </label>
      </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if fox_filter_option_count > 5 -%}
      <button type="button" class="fox-collection__filter-options-toggle" data-filter-options-toggle aria-controls="fox-collection-material-options-{{ collection.id | default: 0 }}" aria-expanded="true" hidden>Xem thêm</button>
    {%- endif -%}
  </details>
  {%- endif -%}

  
  {%- if settings.use_form_filter -%}
  <details class="fox-collection__filter-group" open>
    <summary>{{ settings.title_form_filter | default: 'Form dáng' | escape }}</summary>
    {%- assign fox_filter_option_count = 0 -%}
    <ul id="fox-collection-fit-options-{{ collection.id | default: 0 }}" class="fox-collection__filter-options fox-scrollbar">
      {%- for tag in collection.all_tags -%}
        {%- if tag contains 'fit:' -%}
          {%- assign fox_tag_label = tag | split: ':' | last | strip -%}
          {%- assign fox_filter_option_count = fox_filter_option_count | plus: 1 -%}
      <li{% if fox_filter_option_count > 5 %} data-filter-extra{% endif %}>
        <label class="fox-collection__filter-option">
          <input type="checkbox" data-filter data-filter-group="fit" data-filter-label="{{ fox_tag_label | escape }}" data-filter-param-value="{{ tag | escape }}" data-filter-value="(tag:product contains {{ tag | escape }})">
          <span>{{ fox_tag_label | escape }}</span>
        </label>
      </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if fox_filter_option_count > 5 -%}
      <button type="button" class="fox-collection__filter-options-toggle" data-filter-options-toggle aria-controls="fox-collection-fit-options-{{ collection.id | default: 0 }}" aria-expanded="true" hidden>Xem thêm</button>
    {%- endif -%}
  </details>
  {%- endif -%}

  </div>
</aside>
