<section class="fox-customer__form-panel" data-customer-panel="register" aria-labelledby="fox-customer-title">
  <h2 id="fox-customer-title">{{ fox_customer_text[1] }}</h2>
  <p class="fox-customer__subtitle">{{ fox_customer_text[27] }}</p>

  {% if settings.header_account_use_otp_template %}
    <div class="fox-customer__method" role="group" aria-label="{{ fox_customer_text[1] }}">
      <button type="button" class="is-active" data-customer-method="standard">{{ fox_customer_text[28] }}</button>
      <button type="button" data-customer-method="phone">{{ fox_customer_text[15] }}</button>
    </div>
  {% endif %}

  <div data-customer-standard-login>
    {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <div class="fox-customer__field-row">
        <div class="fox-floating-field fox-customer__field">
          <input id="fox-customer-last-name" type="text" name="customer[last_name]" autocomplete="family-name" placeholder=" " required>
          <label for="fox-customer-last-name">Họ</label>
        </div>
        <div class="fox-floating-field fox-customer__field">
          <input id="fox-customer-first-name" type="text" name="customer[first_name]" autocomplete="given-name" placeholder=" " required>
          <label for="fox-customer-first-name">Tên</label>
        </div>
      </div>
      <div class="fox-customer__gender" role="group" aria-label="Giới tính">
        <label class="fox-form-control fox-form-control--radio">
          <input type="radio" value="0" name="customer[gender]">
          <span class="fox-form-control__indicator" aria-hidden="true"></span>
          <span>Nữ</span>
        </label>
        <label class="fox-form-control fox-form-control--radio">
          <input type="radio" value="1" name="customer[gender]">
          <span class="fox-form-control__indicator" aria-hidden="true"></span>
          <span>Nam</span>
        </label>
      </div>
      <div class="fox-floating-field fox-customer__field fox-customer__field--date">
        <input id="fox-customer-birthday" type="text" name="customer[birthday]" autocomplete="bday" placeholder="mm/dd/yyyy" data-date-picker>
      </div>
      <div class="fox-customer__field-row">
        <div class="fox-floating-field fox-customer__field">
          <input id="fox-customer-register-email" type="email" name="customer[email]" autocomplete="email" placeholder=" " required>
          <label for="fox-customer-register-email">{{ fox_customer_text[2] }}</label>
        </div>
        <div class="fox-floating-field fox-customer__field">
          <input id="fox-customer-register-phone" type="tel" name="customer[phone]" autocomplete="tel" inputmode="tel" placeholder=" " required>
          <label for="fox-customer-register-phone">Số điện thoại</label>
        </div>
      </div>
      <div class="fox-floating-field fox-customer__field">
        <input id="fox-customer-register-password" type="password" name="customer[password]" autocomplete="new-password" placeholder=" " required>
        <label for="fox-customer-register-password">{{ fox_customer_text[3] }}</label>
        <button type="button" class="fox-customer__password-toggle" data-password-toggle="fox-customer-register-password" data-label-show="{{ fox_customer_text[24] }}" data-label-hide="{{ fox_customer_text[25] }}" aria-label="{{ fox_customer_text[24] }}">
          <svg class="customer-field__icon icon-eye-show" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use xlink:href="#ic-eye-show"></use></svg>
        </button>
      </div>
      <button class="btn btn-primary fox-hcs__btn btn-effect--out fox-customer__submit" button-effect type="submit">
        <span class="btn__label">{{ fox_customer_text[13] }}</span><span data-btn-effect-span aria-hidden="true"></span>
      </button>
    {% endform %}
  </div>

  {% if settings.header_account_use_otp_template %}
    <script async src="/phone_auth/lib.js"></script>
    <div class="fox-customer__otp" data-customer-otp-panel hidden>
      <form id="phone_auth_recaptcha" data-customer-phone-form>
        <input type="hidden" name="country_code" value="84">
        <div class="fox-floating-field fox-customer__field">
          <input id="fox-customer-phone" type="tel" name="phone_number" inputmode="tel" placeholder=" " pattern="[0-9]{10,12}" required>
          <label for="fox-customer-phone">{{ fox_customer_text[16] }}</label>
        </div>
        <button class="btn btn-primary fox-hcs__btn btn-effect--out fox-customer__submit" button-effect id="phone-auth-submit" type="submit"><span class="btn__label">{{ fox_customer_text[18] }}</span><span data-btn-effect-span aria-hidden="true"></span></button>
      </form>
      <form action="/phone_auth/validate" method="post" data-customer-otp-form hidden>
        <input type="hidden" name="session_info">
        <div class="fox-floating-field fox-customer__field">
          <input id="fox-customer-otp" type="text" name="otp_code" inputmode="numeric" placeholder=" " required>
          <label for="fox-customer-otp">{{ fox_customer_text[17] }}</label>
        </div>
        <button class="btn btn-primary fox-hcs__btn btn-effect--out fox-customer__submit" button-effect type="submit"><span class="btn__label">{{ fox_customer_text[19] }}</span><span data-btn-effect-span aria-hidden="true"></span></button>
      </form>
    </div>
  {% endif %}

  <p class="fox-customer__footer">{{ fox_customer_text[8] }} <a href="/account/login">{{ fox_customer_text[0] }}</a></p>
</section>
