{% assign fox_mini_account_login_placeholder = ' ' %}
{% if settings.header_account_use_otp_template %}{% assign fox_mini_account_login_placeholder = 'Email hoặc Số điện thoại' %}{% endif %}
{% assign fox_mini_account_interactive = false %}
{% if customer or shop.authenticate_type != 'standard' %}{% assign fox_mini_account_interactive = true %}{% endif %}
<mini-account class="fox-mini-account" data-use-otp-template="{{ settings.header_account_use_otp_template | default: false }}" data-authenticate-type="{{ shop.authenticate_type | escape }}">
  {% if fox_mini_account_interactive %}
    <button type="button" class="fox-header-action fox-mini-account__trigger" data-account-trigger aria-controls="fox-mini-account-panel" aria-expanded="false" aria-label="Đăng nhập"><svg class="icon-svg" aria-hidden="true"><use xlink:href="#ic-account"></use></svg></button>
  {% else %}
    <a class="fox-header-action fox-mini-account__trigger" href="/account/login" aria-label="Đăng nhập"><svg class="icon-svg" aria-hidden="true"><use xlink:href="#ic-account"></use></svg></a>
  {% endif %}
  {% if fox_mini_account_interactive %}
    <div class="fox-mini-account__overlay" data-account-overlay hidden></div>
    <aside id="fox-mini-account-panel" class="fox-mini-account__panel" data-account-panel hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="fox-mini-account-title">
      {% if customer %}
        <section class="fox-mini-account__view" data-account-view="account">
          <p class="fox-mini-account__name">
            <span class="fox-mini-account__name-label">Xin chào</span> {{ customer.first_name }} {{ customer.last_name }}!
          </p>
          <a class="fox-text-link" href="/account">Tài khoản của tôi</a>
          <a class="fox-text-link" href="/account/addresses">Danh sách địa chỉ</a>
          <a class="fox-text-link" href="/account/logout">Đăng xuất</a>
        </section>
      {% else %}
        <section class="fox-mini-account__view" data-account-view="login">
          <h2 id="fox-mini-account-title">Đăng nhập</h2>
          {% form 'customer_login' %}
            {{ form.errors | default_errors }}
            <div class="fox-floating-field fox-mini-account__field"><input id="fox-mini-account-email" type="email" name="customer[email]" autocomplete="email" inputmode="email" placeholder="{{ fox_mini_account_login_placeholder }}" required><label for="fox-mini-account-email">Email</label></div>
            <div class="fox-floating-field fox-mini-account__field"><input id="fox-mini-account-password" type="password" name="customer[password]" autocomplete="current-password" placeholder=" " required><label for="fox-mini-account-password">Mật khẩu</label><button type="button" class="fox-mini-account__password-toggle" data-password-toggle="fox-mini-account-password" data-label-show="Hiện mật khẩu" data-label-hide="Ẩn mật khẩu" aria-label="Hiện mật khẩu"><svg class="customer-field__icon icon-eye-show" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use xlink:href="#ic-eye-show"></use></svg></button></div>
            <button type="submit" class="button btn btn-primary fox-hcs__btn btn-effect--out" button-effect><span class="btn__label">Đăng nhập</span><span data-btn-effect-span aria-hidden="true"></span></button>
          {% endform %}
          <p><span>Bạn chưa có tài khoản?</span> <a href="/account/register">Đăng ký ngay</a></p>
          <button type="button" class="link fox-mini-account__recover-trigger" data-account-view-trigger="recover"><span>Bạn đã quên mật khẩu?</span> <span class="fox-mini-account__recover-link">Quên mật khẩu</span></button>
        </section>
        <section class="fox-mini-account__view" data-account-view="recover" hidden>
          <h2>Khôi phục mật khẩu</h2>
          {% form 'recover_customer_password' %}
            {{ form.errors | default_errors }}
            <div class="fox-floating-field fox-mini-account__field"><input id="fox-mini-account-recover-email" type="email" name="email" autocomplete="email" inputmode="email" placeholder=" " required><label for="fox-mini-account-recover-email">Email</label></div>
            <button type="submit" class="button btn btn-primary fox-hcs__btn btn-effect--out" button-effect><span class="btn__label">Khôi phục mật khẩu</span><span data-btn-effect-span aria-hidden="true"></span></button>
          {% endform %}
          <button type="button" class="link" data-account-view-trigger="login">Trở về đăng nhập</button>
        </section>
      {% endif %}
    </aside>
  {% endif %}
</mini-account>
