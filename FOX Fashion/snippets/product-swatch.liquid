{%- if product.variants.size > 1 -%}
{%- comment -%}Size guide trigger: options whose handle contains  "kich-thuoc" or "size" get a button that opens snippets/size-guide-modal.liquid.{%- endcomment -%}
{%- assign size_guide_enabled = false -%}
{%- if settings.size_guide_show -%}
  {%- assign size_guide_page = settings.size_guide_page_url | strip -%}
  {%- assign size_guide_sheet = settings.size_guide_sheet_url | strip -%}
  {%- if size_guide_page != blank or size_guide_sheet != blank -%}{%- assign size_guide_enabled = true -%}{%- endif -%}
{%- endif -%}

<div class="fox-product__variants" data-role="variant-picker">
  {%- for option in product.options -%}
  {%- assign option_name = option.name | default: option -%}
  {%- assign option_slug = option_name | strip | handleize -%}
  {%- assign option_index = forloop.index0 -%}
  {%- assign option_values_seen = '|' -%}
  {%- assign selected_option_value = selected_variant.option1 -%}
  {%- if option_index == 1 -%}{%- assign selected_option_value = selected_variant.option2 -%}{%- endif -%}
  {%- if option_index == 2 -%}{%- assign selected_option_value = selected_variant.option3 -%}{%- endif -%}
  {%- assign is_color_option = false -%}
  {%- if option_slug contains 'mau-sac' or option_slug contains 'mau' or option_slug contains 'color' -%}
    {%- assign is_color_option = true -%}
  {%- endif -%}
  {%- assign is_size_option = false -%}
  {%- if size_guide_enabled and is_color_option == false -%}
    {%- if option_slug contains 'kich-thuoc' or option_slug contains 'size' -%}
      {%- assign is_size_option = true -%}
    {%- endif -%}
  {%- endif -%}
  {%- capture option_label_id -%}fox-option-label-{{ fox_product_context }}{{ swatch_scope }}-{{ product.id }}-{{ option_index }}{%- endcapture -%}
  <fieldset class="fox-product__option{% if is_size_option %} fox-product__option--size-guide{% endif %}" data-option-index="{{ option_index }}" aria-labelledby="{{ option_label_id }}"{% if is_size_option %} data-size-guide-option data-size-guide-code="{{ option_slug }}"{% endif %}>
    <legend class="fox-product__option-head">
      <span class="fox-product__option-label" id="{{ option_label_id }}">{{ option_name | escape }}: <span data-role="option-name">{{ selected_option_value | escape }}</span></span>
      {%- if is_size_option -%}
      <button type="button" class="fox-product__size-guide-trigger fox-link-effect" data-size-guide-open data-size-guide-code="{{ option_slug }}" aria-haspopup="dialog">
        <svg class="icon-svg" aria-hidden="true" focusable="false"><use xlink:href="#ic-fox-support-size"></use></svg>
        <span class="fox-link-effect__label">{{ settings.size_guide_button_label | default: 'Hướng dẫn chọn size' | escape }}</span>
        <svg class="fox-link-effect__graphic" width="300%" height="100%" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M0,56.5c0,0,298.666,0,399.333,0C448.336,56.5,513.994,46,597,46c77.327,0,135,10.5,200.999,10.5c95.996,0,402.001,0,402.001,0"></path>
        </svg>
      </button>
      {%- endif -%}
    </legend>
    {%- if is_color_option -%}
    <div class="fox-product__swatches" role="radiogroup" aria-label="{{ option_name | escape }}">
      {%- for variant in product.variants -%}
      {%- assign option_value = variant.option1 -%}
      {%- if option_index == 1 -%}{%- assign option_value = variant.option2 -%}{%- endif -%}
      {%- if option_index == 2 -%}{%- assign option_value = variant.option3 -%}{%- endif -%}
      {%- assign option_handle = option_value | handleize -%}
      {%- capture option_token -%}|{{ option_handle }}|{%- endcapture -%}
      {%- unless option_value == blank or option_values_seen contains option_token -%}
      {%- assign option_values_seen = option_values_seen | append: option_handle | append: '|' -%}
      {%- assign swatch_image = '' -%}
      {%- for image_variant in product.variants -%}
        {%- assign image_variant_value = image_variant.option1 -%}
        {%- if option_index == 1 -%}{%- assign image_variant_value = image_variant.option2 -%}{%- endif -%}
        {%- if option_index == 2 -%}{%- assign image_variant_value = image_variant.option3 -%}{%- endif -%}
        {%- if image_variant_value == option_value and image_variant.image.src != blank -%}
          {%- assign swatch_image = image_variant.image.src -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      <button
        type="button"
        class="fox-product__swatch fox-product__swatch--color swatch color mau-{{ option_handle }} fox-color--{{ option_handle }}{% if option_value == selected_option_value %} is-active{% endif %}"
        data-option-value="{{ option_value | escape }}"
        role="radio"
        aria-label="{{ option_value | escape }}"
        aria-checked="{% if option_value == selected_option_value %}true{% else %}false{% endif %}">
        {%- if swatch_image != '' -%}
        <img class="fox-product__swatch-image" src="{{ swatch_image | product_img_url: 'thumb' }}" alt="" width="48" height="48" loading="lazy">
        {%- else -%}
        <span class="fox-product__swatch-color" aria-hidden="true"></span>
        {%- endif -%}
      </button>
      {%- endunless -%}
      {%- endfor -%}
    </div>
    {%- else -%}
    <div class="fox-product__swatches fox-product__swatches--buttons" role="radiogroup" aria-label="{{ option_name | escape }}">
      {%- for variant in product.variants -%}
      {%- assign option_value = variant.option1 -%}
      {%- if option_index == 1 -%}{%- assign option_value = variant.option2 -%}{%- endif -%}
      {%- if option_index == 2 -%}{%- assign option_value = variant.option3 -%}{%- endif -%}
      {%- assign option_handle = option_value | handleize -%}
      {%- capture option_token -%}|{{ option_handle }}|{%- endcapture -%}
      {%- unless option_value == blank or option_values_seen contains option_token -%}
      {%- assign option_values_seen = option_values_seen | append: option_handle | append: '|' -%}
      <button
        type="button"
        class="fox-product__swatch fox-product__swatch--button{% if option_value == selected_option_value %} is-active{% endif %}"
        data-option-value="{{ option_value | escape }}"
        role="radio"
        aria-checked="{% if option_value == selected_option_value %}true{% else %}false{% endif %}">{{ option_value | escape }}</button>
      {%- endunless -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
  </fieldset>
  {%- endfor -%}
</div>
{%- endif -%}
