{%- comment -%}
  Uploaded settings image or an empty surface.
  Input: media_key (setting file name), media_alt, media_w, media_h, media_class, media_loading, media_sizes.
{%- endcomment -%}
{%- assign media_file = settings[media_key] -%}
{%- assign media_alt_safe = media_alt | strip | escape -%} 
<div class="fox-page-media{% if media_class != blank %} {{ media_class }}{% endif %}{% if media_file == blank %} fox-page-media--empty{% endif %}">
  {%- if media_file != blank -%}
    {%- if media_file contains '//' -%}
      <img src="{{ media_file | escape }}" alt="{{ media_alt_safe }}" width="{{ media_w }}" height="{{ media_h }}" loading="{{ media_loading | default: 'lazy' }}" decoding="async">
    {%- else -%}
      {%- include 'render-img' with src: media_file, alt: media_alt_safe, w: media_w, h: media_h, loading: media_loading, sizes: media_sizes -%}
    {%- endif -%}
  {%- endif -%}
</div>
{%- assign media_class = '' -%}
{%- assign media_loading = '' -%}
{%- assign media_sizes = '' -%}
