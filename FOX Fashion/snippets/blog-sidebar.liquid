{%- if template contains 'article' -%}
  {%- assign sidebar_menu = settings.article_menu -%}
  {%- assign sidebar_menu_title = settings.article_menu_title | default: 'Danh mục' -%}
  {%- assign sidebar_show_recent = settings.article_show_recent -%}
  {%- assign sidebar_recent_title = settings.article_recent_title | default: 'Bài mới' -%}
{%- else -%}
  {%- assign sidebar_menu = settings.blog_menu -%}
  {%- assign sidebar_menu_title = settings.blog_menu_title | default: 'Danh mục' -%}
  {%- assign sidebar_show_recent = settings.blog_show_recent -%}
  {%- assign sidebar_recent_title = settings.blog_recent_title | default: 'Bài mới' -%}
{%- endif -%}

<aside class="fox-blog-sidebar" aria-label="Thanh bên blog">
  {%- if sidebar_menu != blank and linklists[sidebar_menu].links.size > 0 -%}
  <nav class="fox-blog-glass" aria-label="{{ sidebar_menu_title | escape }}">
    <p class="fox-blog-glass__title">{{ sidebar_menu_title | escape }}</p>
    {%- assign menu_accordion_handle = sidebar_menu -%}
    {%- assign menu_accordion_id = 'fox-blog-menu' -%}
    {%- include 'component-menu-accordion' -%}
  </nav>
  {%- endif -%} 

  {%- if sidebar_show_recent != false -%}
    {%- assign recent_count = 0 -%}
    {%- capture recent_html -%}
      {%- for recent_article in blog.articles -%}
        {%- if recent_article.id != article.id and recent_count < 4 -%}
          {%- assign recent_count = recent_count | plus: 1 -%}
          <li>
            <a class="fox-blog-recent__item" href="{{ recent_article.url | escape }}">
              <span class="fox-blog-recent__media">
                {%- if recent_article.image -%}
                <img src="{{ recent_article.image.src | product_img_url: 'small' }}" alt="" width="100" height="100" loading="lazy" decoding="async">
                {%- endif -%}
              </span>
              <span class="fox-blog-recent__text">
                <strong>{{ recent_article.title | escape }}</strong>
                <time datetime="{{ recent_article.published_at | date: '%Y-%m-%d' }}">{{ recent_article.published_at | date: '%d/%m/%Y' }}</time>
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if recent_count > 0 -%}
    <div class="fox-blog-glass">
      <p class="fox-blog-glass__title">{{ sidebar_recent_title | escape }}</p>
      <ul class="fox-blog-recent">{{ recent_html }}</ul>
    </div>
    {%- endif -%}
  {%- endif -%}
</aside>
