{% assign fox_account_title = 'Chi tiết đơn hàng' %}
{% assign fox_account_description = 'Theo dõi thông tin và trạng thái đơn hàng của bạn.' %}
{% capture fox_account_content %}
<div class="fox-account-legacy fox-account-legacy--order">
<div class="layout-account">
	<div class="container">
		<div class="wrapbox-content-account">
			<div class="row">
				<div class="col-12" >
					<div class="grouptitle-order">
						<h3 class="order_name">Đơn hàng: {{ order.name }},
							<span class="order_date">Đặt lúc &mdash; {{ order.created_at | date: "%d/%m/%Y, %I:%M%p" }}</span>
						</h3>
						{% if order.cancelled %}
						<div id="order_cancelled" class="order_cancelled">
							<h4 id="order_cancelled_title">Hủy đơn hàng <span>{{ order.cancelled_at | date: "%d/%m/%Y, %I:%M%p" }}</span></h4>
							<span>{{ order.cancel_reason }}</span>
						</div>
						{% endif %}
					</div>
					<div class="row">
						<div class="col-12">
							<a href="/account" id='return_to_store' class="order_backhome"><svg class="icon-svg order_backhome__icon" aria-hidden="true" focusable="false"><use xlink:href="#ic-arrow-left-s"></use></svg>Quay lại trang tài khoản</a>
						</div>				
						<div class="col-12 content-page ">
							<div class="customer-table-wrap">
								<div class="customer-table-bg">	
									<p class="title-detail">Chi tiết đơn hàng	</p>
									<div class="wrap-table-orderline table-responsive-overflow">
										<div class="table-responsive">
											<table id="order_details" class="table table-customers ">
												<thead>
													<tr>
														<th class=""></th>
														<th class="">Sản phẩm</th>
														<th class="text-center">Mã sản phẩm</th>
														<th class="text-center">Đơn giá</th>
														<th class="text-center">Số lượng</th>
														<th class="total text-right">Thành tiền</th>
													</tr>
												</thead>
												{% for line_item in order.line_items %}
												<tr id="{{ line_item.product_id }}" class="line-order {% cycle 'odd', 'even' %}">
													<td class="order-image" >											
														<a href="{{ line_item.url }}" aria-label="{{ line_item.title }}">									
															<img src="{% if line_item.image > 0 %}{{ line_item.image | product_img_url : 'small'}}{% else %}{{'no_image.jpg' | asset_url}}{% endif %}" alt="{{ line_item.title }}" />
														</a>
													</td>
													<td class="name" style="max-width:300px">
														{{ line_item.product.title | link_to: line_item.url }} <br/> 
														<span class="variant_acc">
															{%unless line_item.variant.title contains 'Default' %}
															{{line_item.variant.title}}
															{%endunless%}
														</span>
														{% if line_item.fulfillment %}
														<div>
															Fulfilled {{ line_item.fulfillment.created_at | date: "%b %d" }}
															{% if line_item.fulfillment.tracking_number %}
															<a href="{{ line_item.fulfillment.tracking_url }}">{{ line_item.fulfillment.tracking_company }} #{{ line_item.fulfillment.tracking_number}}</a>
															{% endif %}
														</div>
														{% endif %}
													</td>
													<td class="sku text-center" data-label="Mã sản phẩm">{{ line_item.sku }}</td>
													<td class="money text-center" data-label="Đơn giá">{{ line_item.price | money }}</td>
													<td class="quantity center text-center" data-label="Số lượng">{{ line_item.quantity }}</td>
													<td class="total money text-right" data-label="Thành tiền">{{ line_item.quantity | times: line_item.price | money }}</td>
												</tr>
												{% endfor %}
											</table>
										</div>
									</div>		
									<div class="wrap-table-ordership">
										<table class="table table-customers table-customers-summary ">
											<tr class="order_summary ">
												<td class="text-left" colspan="4"><b>Giá sản phẩm</b></td>
												<td class="total money text-right"><b>{{ order.subtotal_price | money }}</b></td>
											</tr>   
											{% for shipping_method in order.shipping_methods %}
											<tr class="order_summary ">
												<td class="text-left" colspan="4"><b>{{ shipping_method.title }}</b></td>
												<td class="total money text-right"><b>{{ shipping_method.price | money }}</b></td>
											</tr>
											{% endfor %}
											{% for tax_line in order.tax_lines %}
											<tr class="order_summary ">
												<td class="text-left" colspan="4"><b>{{ tax_line.title }} {{ tax_line.rate | times: 100 }}</b>%</td>
												<td class="total money text-right"><b>{{ tax_line.price | money }}</b></td>
											</tr>
											{% endfor %}  
											<tr class="order_summary order_total">
												<td class="text-left" colspan="4"><b>Tổng tiền</b></td>
												<td class="total money text-right"><b>{{ order.total_price | money }} {{ order.currency }}</b></td>
											</tr>   

										</table> 
									</div>	
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
</div>

{% endcapture %}
{%- capture fox_account_sidebar_extra -%}
<section class="fox-account-panel fox-account-order-card" aria-labelledby="fox-order-payment-title">
	<h2 id="fox-order-payment-title">Địa chỉ nhận thanh toán</h2>
	<p class="fox-account-order-card__status">
		<span>Thanh toán</span>
		<strong class="status_{{ order.financial_status }}">{{ order.financial_status | replace: 'pending', 'Chờ xử lý' | replace: 'paid', 'Đã thanh toán' }}</strong>
	</p>
	{%- assign order_address = order.billing_address -%}
	{%- include 'customer-order-address' -%}
</section>
{%- if order.shipping_address -%}
<section class="fox-account-panel fox-account-order-card" aria-labelledby="fox-order-shipping-title">
	<h2 id="fox-order-shipping-title">Địa chỉ gửi hàng</h2>
	<p class="fox-account-order-card__status">
		<span>Vận chuyển</span>
		<strong class="status_{{ order.fulfillment_status }}">
			{%- if order.shipment_status == 'readytopick' or order.shipment_status == 'picking' -%}Đang xử lý
			{%- elsif order.shipment_status == 'delivering' or order.shipment_status == 'notmeetcustomer' -%}Đang giao hàng
			{%- elsif order.shipment_status == 'delivered' -%}Đã giao hàng
			{%- elsif order.shipment_status == 'cancel' -%}Đã hủy
			{%- elsif order.shipment_status == 'return' or order.shipment_status == 'waitingforreturn' -%}Giao không thành công
			{%- elsif order.shipment_status == 'pending' -%}Chờ xử lý
			{%- endif -%}
		</strong>
	</p>
	{%- assign order_address = order.shipping_address -%}
	{%- include 'customer-order-address' -%}
</section>
{%- endif -%}
{%- endcapture -%}
{% include 'account-hero' %}
