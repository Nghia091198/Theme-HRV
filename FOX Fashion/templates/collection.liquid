{%- assign fox_collection_limit = settings.pagination_limit | default: 12 | plus: 0 -%}
{%- if fox_collection_limit < 1 -%}{%- assign fox_collection_limit = 12 -%}{%- endif -%}
{%- assign fox_collection_base_query = '(collectionid:product>0)' -%}
{%- if collection.handle != 'all' -%}
  {%- capture fox_collection_base_query -%}(collectionid:product={{ collection.id }}){%- endcapture -%}
{%- endif -%}
{%- assign fox_collection_url = collection.url | default: '/collections/all' -%}
{%- assign fox_collection_filter_enabled = settings.show_collection_filter -%}
{%- assign fox_collection_banner = blank -%}

{%- if settings.collection_image_show -%}
  {%- if collection.image != blank -%}
    {%- assign fox_collection_banner = collection.image.src -%}
  {%- elsif settings['collection_banner.jpg'] != blank -%}
    {%- assign fox_collection_banner = settings['collection_banner.jpg'] -%}
    {%- unless fox_collection_banner contains '//' -%}
      {%- assign fox_collection_banner = fox_collection_banner | asset_url -%}
    {%- endunless -%}
  {%- endif -%}
{%- endif -%}

<div class="fox-collection" data-collection-root data-state="ready"
  data-collection-url="{{ fox_collection_url | escape }}"
  data-collection-id="{{ collection.id | default: 0 }}"
  data-collection-handle="{{ collection.handle | escape }}"
  data-base-query="{{ fox_collection_base_query | escape }}"
  data-products-template="{{ fox_collection_url | escape }}?view=data"
  data-search-template="/search?view=data"
  data-query-param="q"
  data-push-filter-params="true"
  data-pagination-mode="links"
  data-has-filter="{% if fox_collection_filter_enabled %}true{% else %}false{% endif %}"
  data-sort-count="4"
  data-page-size="{{ fox_collection_limit }}">
  <header class="fox-collection__hero{% if fox_collection_banner != blank %} fox-collection__hero--image{% endif %}">
    {%- include 'collection-header' -%}
    {%- include 'collection-navigate' -%}
    </div>
  </header>

  <section class="fox-collection__shop container" aria-label="Danh sách sản phẩm">
    {%- paginate collection.products by fox_collection_limit -%}
    {%- assign fox_collection_result_start = paginate.current_page | minus: 1 | times: fox_collection_limit | plus: 1 -%}
    {%- assign fox_collection_result_end = paginate.current_page | times: fox_collection_limit -%}
    {%- if fox_collection_result_end > paginate.items -%}{%- assign fox_collection_result_end = paginate.items -%}{%- endif -%}
    {%- if paginate.items == 0 -%}{%- assign fox_collection_result_start = 0 -%}{%- endif -%}
    <div class="fox-collection__toolbar">
      <div class="fox-collection__toolbar-summary">
        {%- if settings.fox_collection_show_count != false -%}
        <p class="fox-collection__count">Hiển thị <strong data-role="result-range">{{ fox_collection_result_start }}–{{ fox_collection_result_end }}</strong> trong <strong data-role="result-count">{{ paginate.items }}</strong> sản phẩm</p>
        {%- endif -%}
        <div class="fox-collection__active" data-role="active-filters" aria-live="polite"></div><button type="button" class="fox-collection__clear fox-collection__toolbar-clear" data-filter-reset hidden>Xóa tất cả</button>
      </div>
      <div class="fox-collection__toolbar-actions">
        {%- if fox_collection_filter_enabled -%}
        <button type="button" class="fox-collection__filter-toggle" data-filter-toggle aria-expanded="false" aria-controls="fox-collection-filters" hidden>Bộ lọc</button>
        {%- endif -%}
        <details class="fox-collection__sort" data-sort data-sort-value="manual">
          <summary><span class="fox-collection__sort-caption">Sắp xếp theo</span><span data-sort-label>Nổi bật</span><span class="fox-collection__sort-chevron" aria-hidden="true"></span></summary>
          <ul class="fox-collection__sort-options" data-role="sort-options" aria-label="Sắp xếp sản phẩm">
            <li><a href="{{ fox_collection_url | escape }}" data-sort-option="manual" aria-current="true">Nổi bật</a></li>
            <li><a href="{{ fox_collection_url | escape }}?sort_by=created-descending" data-sort-option="created-descending">Mới nhất</a></li>
            <li><a href="{{ fox_collection_url | escape }}?sort_by=price-ascending" data-sort-option="price-ascending">Giá: thấp đến cao</a></li>
            <li><a href="{{ fox_collection_url | escape }}?sort_by=price-descending" data-sort-option="price-descending">Giá: cao đến thấp</a></li>
          </ul>
        </details>
        <div class="fox-collection__views" role="group" aria-label="Kiểu hiển thị sản phẩm" hidden>
          <button type="button" data-view-toggle="grid" aria-label="Hiển thị dạng lưới" aria-pressed="true" title="Dạng lưới"><svg aria-hidden="true"><use xlink:href="#ic-grid"></use></svg></button>
          <button type="button" data-view-toggle="list" aria-label="Hiển thị dạng danh sách" aria-pressed="false" title="Dạng danh sách"><svg aria-hidden="true"><use xlink:href="#ic-list"></use></svg></button>
        </div>
      </div>
    </div>

    <div class="fox-collection__layout">
      {%- if fox_collection_filter_enabled -%}
      <div id="fox-collection-filters">
        {%- include 'collection-facets' -%}
      </div>
      {%- endif -%}
      <div class="fox-collection__results" data-role="results" aria-busy="false">
        {%- include 'collection-results' -%}
        <div class="fox-collection__loading" data-role="loading" hidden>
          {%- include 'component-skeleton' with type: 'default', item: 3, row: 2 -%}
        </div>
        <p class="fox-collection__status" data-role="status" aria-live="polite"></p>
      </div>
      {%- include 'collection-promo' -%}
    </div>
    {%- endpaginate -%}
    {%- if fox_collection_filter_enabled -%}<button type="button" class="fox-collection__filter-overlay" data-filter-overlay data-filter-close aria-label="Đóng bộ lọc" hidden></button>{%- endif -%}
  </section>
  {%- include 'collection-benefits' -%}
</div>
