html {
    font-size: 62.5%;
}
body {
    line-height: 1.45;
    background: var(--shop-bg-color);
    font-family: var(--base-font), sans-serif;
    position: initial;
    font-size: 14px;
}
body,a {color: var(--shop-text-color);} 
h1,h2,h3,h4,h5,h6,
.h1,.h2,.h3,.h4,.h5,.h6 {
    font-family: var(--base-font-title), sans-serif;
}

.fox-pagination__progress {
    margin: 42px 0 8px;
    color: var(--color-text-secondary, #687078);
    font-size: 14px;
    text-align: center;
}
.fox-pagination__track {
    width: 160px;
    height: 3px;
    margin: 0 auto;
    background: var(--color-border, #e4e5e6);
}
.fox-pagination__track span {
    display: block;
    height: 100%;
    background: var(--color-text-theme, #1b2631);
}
.fox-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
}
.fox-pagination__pages {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
}
.fox-pagination__link {
    --p-size: 44px;
    --btn-color: var(--color-border, #e4e5e6);
    display: grid;
    width: var(--p-size);
    height: var(--p-size);
    place-items: center;
    border: 1px solid var(--color-border, #e4e5e6);
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-theme, #1b2631);
    font-size: 15px;
    text-align: center;
    text-decoration: none;
}
.fox-pagination .fox-pagination__link {
    padding: 0;
}
.fox-pagination__link--direction .icon-svg {
    display: block;
    position: relative;
    z-index: 1;
    --icon-width: 18px;
    --icon-height: 14px;
}
.fox-pagination__link--direction[data-pagination-link="previous"] .icon-svg {
    transform: rotate(-180deg);
}
.fox-pagination__link:hover {
    border-color: var(--color-text-theme, #1b2631);
}
.fox-pagination__link.is-current {
    border-color: var(--color-btn-bg-primary, #1b2631);
    background: var(--color-btn-bg-primary, #1b2631);
    color: var(--color-btn-text-primary, #fff);
}
.fox-pagination__link:focus-visible {
    outline: 2px solid var(--color-text-theme, #1b2631);
    outline-offset: 3px;
}
@media (prefers-reduced-motion: reduce) {
    .fox-pagination__link [data-btn-effect-span] {
        transition: none;
    }
}

/* Global focus (zero specificity with :where(), so any component can still set its own focus style).
   Text fields never draw the browser focus box: the caret shows focus and their wrappers (search pill, form
   fields) highlight with :focus-within. Buttons and links: no ring after a mouse click, a clean ring that follows
   their shape for keyboard focus (needed for accessibility). */
:where(input, textarea, select):focus,
:where(input, textarea, select):focus-visible {
    outline: none;
}

:where(button, a, summary, [role="button"], [tabindex]):focus:not(:focus-visible) {
    outline: none;
}

:where(button, a, summary, [role="button"], [tabindex]):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
}

/* Checkboxes, radios and switches stay visible to the keyboard (they have no caret). */
:where(input[type="checkbox"], input[type="radio"]):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
}

/* .reset-style: wrap merchant rich text (page / article / product description) to restore readable
   defaults removed by the theme reset. Borders and fills use currentColor so it fits light or dark surfaces. */
.reset-style {
    --reset-style-line: color-mix(in srgb, currentColor 16%, transparent);
    --reset-style-fill: color-mix(in srgb, currentColor 6%, transparent);
    --reset-style-accent: var(--color-btn-bg-primary, #1b2631);
    --reset-style-gap: 1.6rem;
    font-size: 1.5rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
}
.reset-style > :first-child {
    margin-top: 0;
}
.reset-style > :last-child {
    margin-bottom: 0;
}

/* Headings */
.reset-style h1,
.reset-style h2,
.reset-style h3,
.reset-style h4,
.reset-style h5,
.reset-style h6 {
    margin: 3.2rem 0 1.2rem;
    color: inherit;
    font-weight: 700;
    line-height: 1.3;
}
.reset-style h1 { font-size: clamp(2.8rem, 3.4vw, 3.6rem); }
.reset-style h2 { font-size: clamp(2.2rem, 2.6vw, 2.8rem); }
.reset-style h3 { font-size: clamp(1.9rem, 2.1vw, 2.2rem); }
.reset-style h4 { font-size: 1.8rem; }
.reset-style h5 { font-size: 1.6rem; }
.reset-style h6 {
    font-size: 1.4rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

/* Text */
.reset-style p,
.reset-style ul,
.reset-style ol,
.reset-style dl,
.reset-style blockquote,
.reset-style figure,
.reset-style pre,
.reset-style table {
    margin: 0 0 var(--reset-style-gap);
}
.reset-style a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
}
.reset-style a:hover {
    text-decoration-thickness: 2px;
}
.reset-style strong,
.reset-style b {
    font-weight: 700;
}
.reset-style em,
.reset-style i {
    font-style: italic;
}
.reset-style small {
    font-size: 0.85em;
}
.reset-style mark {
    padding: 0 0.2em;
    color: inherit;
    background: color-mix(in srgb, var(--reset-style-accent) 18%, transparent);
    border-radius: 0.3rem;
}

/* Lists */
.reset-style ul,
.reset-style ol {
    padding-left: 2.2rem;
}
.reset-style ul {
    list-style: disc;
}
.reset-style ol {
    list-style: decimal;
}
.reset-style ul ul {
    list-style: circle;
}
.reset-style li {
    margin-bottom: 0.6rem;
}
.reset-style li > ul,
.reset-style li > ol {
    margin: 0.6rem 0 0;
}
.reset-style dt {
    font-weight: 700;
}
.reset-style dd {
    margin: 0 0 1rem 1.6rem;
}

/* Quote */
.reset-style blockquote {
    padding: 1.6rem 2rem;
    font-size: 1.05em;
    font-style: italic;
    background: var(--reset-style-fill);
    border-left: 3px solid var(--reset-style-accent);
    border-radius: 0 1.2rem 1.2rem 0;
}
.reset-style blockquote > :last-child {
    margin-bottom: 0;
}
.reset-style blockquote cite,
.reset-style blockquote footer {
    display: block;
    margin-top: 0.8rem;
    font-size: 0.85em;
    font-style: normal;
    opacity: 0.75;
}

/* Table */
.reset-style table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--reset-style-line);
    font-size: 0.93em;
    line-height: 1.5;
}
.reset-style th,
.reset-style td {
    padding: 1rem 1.4rem;
    text-align: left;
    vertical-align: top;
    border: 1px solid var(--reset-style-line);
}
.reset-style thead th,
.reset-style thead td,
.reset-style tr > th:only-child {
    font-weight: 700;
    background: var(--reset-style-fill);
}
.reset-style tbody tr:nth-child(even) {
    background: color-mix(in srgb, currentColor 3%, transparent);
}
.reset-style caption {
    margin-bottom: 0.8rem;
    font-size: 0.9em;
    opacity: 0.75;
    text-align: left;
}

.reset-style img,
.reset-style video {
    max-width: 100%;
    height: auto;
    border-radius: 1.2rem;
}
.reset-style iframe {
    max-width: 100%;
    border: 0;
}
.reset-style iframe[src*="youtube"],
.reset-style iframe[src*="vimeo"] {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
}
.reset-style figure img {
    display: block;
}
.reset-style figcaption {
    margin-top: 0.8rem;
    font-size: 0.85em;
    opacity: 0.75;
    text-align: center;
}

/* Code & divider */
.reset-style code,
.reset-style kbd {
    padding: 0.1em 0.4em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.88em;
    background: var(--reset-style-fill);
    border-radius: 0.4rem;
}
.reset-style pre {
    padding: 1.4rem 1.6rem;
    overflow-x: auto;
    background: var(--reset-style-fill);
    border-radius: 1rem;
}
.reset-style pre code {
    padding: 0;
    background: none;
}
.reset-style hr {
    height: 0;
    margin: 3.2rem 0;
    border: 0;
    border-top: 1px solid var(--reset-style-line);
}

@media (max-width: 992px) {
    .reset-style {font-size: 1.45rem;}
    .reset-style th,
    .reset-style td {
        padding: 0.8rem 1rem;
    }
    .reset-style blockquote {padding: 1.2rem 1.4rem;}
    .fox-pagination__link {
        --p-size: 34px;
        font-size: 13px;
    }
    .fox-pagination__link--direction .icon-svg {
        --icon-width: 14px;
        --icon-height: 10px;
    }
}
